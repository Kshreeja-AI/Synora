{
  "name": "@synora/orchestration",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent orchestration: a single-agent runtime loop (tools, memory, guardrails, events) and a workflow engine for composing agents into sequences, parallel fan-outs, conditionals, and handoffs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@synora/core": "workspace:*",
    "@synora/event-bus": "workspace:*",
    "@synora/tools": "workspace:*",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@synora/memory": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
