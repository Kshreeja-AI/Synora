// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication Models
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          UserRole    @default(USER)
  status        UserStatus  @default(ACTIVE)

  // OAuth accounts
  accounts      Account[]

  // User data
  profile       UserProfile?
  preferences   UserPreferences?

  // Workspace membership
  workspaces    WorkspaceMember[]

  // Content & projects
  projects      Project[]
  documents     Document[]
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  audios        GeneratedAudio[]

  // Activity tracking
  activityLogs  ActivityLog[]

  // Auth sessions (refresh tokens)
  refreshTokens RefreshToken[]

  // Outstanding password-reset tokens
  passwordResetTokens PasswordResetToken[]

  // Outstanding email-verification tokens
  emailVerificationTokens EmailVerificationToken[]

  // In-app notifications
  notifications Notification[]

  // Workspace invitations sent by this user
  sentInvitations WorkspaceInvitation[]

  // Folders created and assets uploaded by this user
  createdFolders  Folder[]
  uploadedAssets  Asset[]

  // Conversation folders created by this user
  conversationFolders ConversationFolder[]

  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastLoginAt   DateTime?

  // Login lockout: incremented on each failed password verification, reset
  // to 0 on a successful login. lockedUntil is set once the threshold is
  // reached and cleared on the next successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  @@index([status])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  bio           String?
  avatar        String?
  banner        String?
  website       String?
  location      String?
  socialLinks   Json?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model UserPreferences {
  id                String    @id @default(cuid())
  userId            String    @unique
  theme             Theme     @default(LIGHT)
  language          String    @default("en")
  emailNotifications Boolean   @default(true)
  pushNotifications Boolean   @default(false)
  marketingEmails   Boolean   @default(false)

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

enum Theme {
  LIGHT
  DARK
  AUTO
}

// Workspace Models
model Workspace {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  avatar        String?

  members       WorkspaceMember[]
  projects      Project[]
  apiKeys       ApiKey[]
  invitations   WorkspaceInvitation[]
  folders       Folder[]
  assets        Asset[]
  auditLogs     AuditLog[]

  // Billing relations (M6)
  subscription  Subscription?
  invoices      Invoice[]
  paymentMethods PaymentMethod[]
  credits       WorkspaceCredits?
  creditLedger  CreditLedgerEntry[]
  usageRecords  UsageRecord[]

  // Release 3: Chat relations
  conversations       Conversation[]
  conversationFolders ConversationFolder[]
  conversationTags    ConversationTag[]
  aiMemory            AIMemory?
  promptTemplates     PromptTemplate[]
  conversationTemplates ConversationTemplate[]
  tools               Tool[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WorkspaceMember {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String
  role          WorkspaceRole @default(MEMBER)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
  VIEWER
}

model WorkspaceInvitation {
  id            String    @id @default(cuid())
  workspaceId   String
  email         String
  role          WorkspaceRole @default(MEMBER)
  token         String    @unique
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy     User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([token])
}

model ApiKey {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  key           String    @unique
  lastUsedAt    DateTime?
  expiresAt     DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

// Project Models
model Project {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String?
  name          String
  description   String?
  status        ProjectStatus @default(ACTIVE)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  documents     Document[]
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  audios        GeneratedAudio[]
  folders       Folder[]
  assets        Asset[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

// A folder organizes assets within a workspace, optionally scoped to a
// single project and optionally nested under a parent folder. Deleting a
// folder cascades to its subfolders (recursive folder semantics) but only
// detaches (never deletes) the assets inside it — see Asset.folder below.
model Folder {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String?
  parentId      String?
  name          String
  createdById   String

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      Folder[]  @relation("FolderChildren")
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  assets        Asset[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([parentId])
}

// A generic uploaded file, distinct from the AI-generated content models
// above (GeneratedImage/Video/Audio) — an Asset is something a member
// uploaded, not something Synora produced. Stored via the same
// provider-agnostic storage abstraction used for avatars.
model Asset {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String?
  folderId      String?
  name          String
  url           String
  key           String
  mimeType      String
  size          Int
  uploadedById  String

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([folderId])
}

// Per-workspace audit trail for permission-sensitive actions (member
// invited/removed/role-changed, project/folder/asset lifecycle, workspace
// settings changes). actorId is a soft reference — same reasoning as
// MFAAuditLog: the trail must remain queryable even if the actor's account
// is later removed.
model AuditLog {
  id            String    @id @default(cuid())
  workspaceId   String
  actorId       String
  action        String
  targetType    String
  targetId      String?
  metadata      Json?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// Content Models
model Document {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  title         String
  content       String
  format        DocumentFormat @default(MARKDOWN)
  status        ContentStatus @default(DRAFT)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

enum DocumentFormat {
  MARKDOWN
  HTML
  PLAIN_TEXT
  RICH_TEXT
}

model GeneratedImage {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  imageUrl      String
  thumbnailUrl  String?
  width         Int
  height        Int
  model         String
  status        ContentStatus @default(COMPLETED)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([projectId])
}

model GeneratedVideo {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  videoUrl      String
  thumbnailUrl  String?
  duration      Int
  width         Int
  height        Int
  model         String
  status        ContentStatus @default(PROCESSING)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

model GeneratedAudio {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  audioUrl      String
  duration      Int
  model         String
  status        ContentStatus @default(PROCESSING)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

enum ContentStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
  PUBLISHED
}

// Activity Tracking
model ActivityLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  resource      String
  resourceId    String
  metadata      Json?
  ipAddress     String?
  userAgent     String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Session Management (for NextAuth)
model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  expires       DateTime

  createdAt     DateTime  @default(now())

  @@index([userId])
}

model VerificationToken {
  identifier    String
  token         String    @unique
  expires       DateTime

  @@unique([identifier, token])
}

// Refresh tokens for stateful, revocable sessions. The raw opaque token is
// never stored — only its SHA-256 hash — so a database read cannot mint a
// session. Rotation is enforced by revoking the presented token whenever a
// new one is issued; logout revokes the token, which is what makes "log out"
// actually end the session (the short-lived access token expires within
// minutes, and no new one can be minted without a live refresh token).
//
// userAgent/ipAddress/lastUsedAt are device-session metadata captured at
// issue time (and refreshed on rotation) so a signed-in user can see and
// individually revoke their active sessions ("this device", "logout
// everywhere"). rememberMe records which expiry policy produced this
// token's expiresAt, purely for display — it never changes verification.
model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  rememberMe  Boolean   @default(false)

  @@index([userId])
  @@index([expiresAt])
}

// Password-reset tokens. Same hash-at-rest discipline as RefreshToken:
// the raw token only ever appears in the reset email/link. Single-use
// (usedAt) and short-lived (expiresAt); consuming one revokes every
// active refresh token for the user.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Email-verification tokens. Same hash-at-rest discipline as
// PasswordResetToken: the raw token only ever appears in the verification
// email/link. Single-use (usedAt) and short-lived (expiresAt).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// In-app notifications. Created at real event trigger points alongside the
// corresponding transactional email (password changed/reset, email
// verified, workspace created) — never fabricated for display purposes.
model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationType {
  SECURITY
  ACCOUNT
  WORKSPACE
  SYSTEM
  BILLING
}

// MFA Audit Logging
// userId is a soft reference (no FK): audit records must survive user
// lifecycle changes and remain queryable for compliance retention windows.
model MFAAuditLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  metadata      Json?
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([timestamp])
}

// Billing Models
// Admin-editable plan catalog. Each plan defines pricing, credits, trial period,
// and feature set. One plan marked as default for new workspaces.
model Plan {
  id                String      @id @default(cuid())
  key               String      @unique
  name              String
  status            PlanStatus  @default(ACTIVE)
  interval          BillingInterval
  priceCents        Int
  creditsPerInterval Int         @default(0)
  trialDays         Int?
  features          Json?
  isDefault         Boolean     @default(false)
  sortOrder         Int         @default(0)
  providerPriceIds  Json?

  subscriptions     Subscription[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([isDefault])
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

// Exactly one subscription per workspace. Tracks the current plan,
// subscription status, billing periods, and external provider IDs.
model Subscription {
  id                      String              @id @default(cuid())
  workspaceId             String              @unique
  planId                  String
  provider                String?
  externalCustomerId      String?
  externalSubscriptionId  String?
  status                  SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean             @default(false)
  trialEndsAt             DateTime?

  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                    Plan                @relation(fields: [planId], references: [id])

  invoices                Invoice[]
  paymentMethods          PaymentMethod[]

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([workspaceId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIAL
}

// Invoice records synced from the payment provider via webhooks.
// Only reads come from local DB; external-sync happens via webhooks only.
model Invoice {
  id                String          @id @default(cuid())
  subscriptionId    String
  workspaceId       String
  provider          String
  externalInvoiceId String          @unique
  status            InvoiceStatus
  amountDueCents    Int
  amountPaidCents   Int
  currency          String          @default("USD")
  hostedInvoiceUrl  String?
  periodStart       DateTime?
  periodEnd         DateTime?
  issuedAt          DateTime?
  paidAt            DateTime?

  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
  @@index([subscriptionId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

// Payment methods synced from provider via webhooks. Supports multiple
// payment methods per subscription; one marked as default.
model PaymentMethod {
  id                      String              @id @default(cuid())
  subscriptionId          String
  workspaceId             String
  provider                String
  externalPaymentMethodId String              @unique
  type                    PaymentMethodType
  brand                   String?
  last4                   String?
  expiryMonth             Int?
  expiryYear              Int?
  isDefault               Boolean             @default(false)

  subscription            Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([workspaceId])
  @@index([subscriptionId])
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  OTHER
}

// Credit balance per workspace. Denormalized for fast reads;
// source of truth for available balance.
model WorkspaceCredits {
  id            String          @id @default(cuid())
  workspaceId   String          @unique
  balance       Int             @default(0)
  updatedAt     DateTime        @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Append-only credit transaction log. Every grant, deduction, adjustment,
// expiration, or refund creates one entry. Never updated after creation.
model CreditLedgerEntry {
  id            String                  @id @default(cuid())
  workspaceId   String
  type          CreditTransactionType
  amount        Int
  balanceAfter  Int
  reason        String
  actorId       String?
  metadata      Json?
  createdAt     DateTime                @default(now())

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

enum CreditTransactionType {
  GRANT
  DEDUCTION
  ADJUSTMENT
  EXPIRATION
  REFUND
}

// Usage records for audit and future analytics. Records when capabilities
// are invoked and how many credits they consume. Callable today (M6),
// first call sites added in M7.
model UsageRecord {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String?
  capability    String
  quantity      Int       @default(1)
  creditsCost   Int
  metadata      Json?
  createdAt     DateTime  @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([capability, createdAt])
}

// Webhook event deduplication table. Prevents duplicate processing of
// the same webhook event replayed by the provider.
model ProcessedWebhookEvent {
  id            String    @id @default(cuid())
  provider      String
  externalEventId String

  createdAt     DateTime  @default(now())

  @@unique([provider, externalEventId])
  @@index([provider, createdAt])
}

// Release 3: Universal AI Workspace - Chat Models

model Conversation {
  id                String    @id @default(cuid())
  workspaceId       String
  title             String
  description       String?
  provider          String
  model             String
  status            ConversationStatus @default(ACTIVE)
  isArchived        Boolean   @default(false)
  isPinned          Boolean   @default(false)
  // Denormalized from the latest Message.createdAt in this conversation,
  // maintained by conversationGeneration.service.ts (M2) — avoids a
  // correlated subquery/join for the default "most recently active first"
  // list sort. Null until the first message is sent.
  lastMessageAt     DateTime?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  messages          Message[]
  folder            ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId          String?
  tags              ConversationTag[]
  collaborators     ConversationCollaborator[]
  versions          ConversationVersion[]
  activity          ConversationActivity[]
  shared            SharedConversation[]
  usage             ConversationUsage?
  toolCalls         ToolCall[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, lastMessageAt])
  @@index([isArchived])
  @@index([isPinned])
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// deletedAt follows the same nullable-timestamp soft-delete convention as
// RefreshToken.revokedAt/WorkspaceInvitation.revokedAt (presence = deleted,
// value = when) rather than introducing a new isDeleted-boolean pattern.
// Added in M1 specifically so M3 (message lifecycle) can implement soft
// delete without a further migration: the architecture calls for deleting a
// message to orphan, not cascade-remove, its children, which soft-delete
// naturally gives for free (a plain UPDATE never triggers the parentId FK's
// cascade — that only fires on an actual SQL DELETE, which soft-delete
// never issues).
model Message {
  id                String    @id @default(cuid())
  conversationId    String
  content           String
  role              MessageRole
  parentId          String?
  deletedAt         DateTime?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent            Message?  @relation("MessageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Message[] @relation("MessageTree")

  branch            MessageBranch?
  attachments       MessageAttachment[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, deletedAt])
  @@index([parentId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model MessageBranch {
  id                String    @id @default(cuid())
  messageId         String    @unique
  branchIndex       Int
  isMainBranch      Boolean   @default(false)

  message           Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([messageId])
}

model MessageAttachment {
  id                String    @id @default(cuid())
  messageId         String
  url               String
  mimeType          String
  name              String
  size              Int

  message           Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([messageId])
}

model ConversationFolder {
  id                String    @id @default(cuid())
  workspaceId       String
  parentId          String?
  name              String
  createdById       String

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent            ConversationFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          ConversationFolder[] @relation("FolderTree")
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([parentId])
  @@index([createdById])
}

model ConversationTag {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String
  color             String?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  createdAt         DateTime  @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PromptTemplate {
  id                String    @id @default(cuid())
  workspaceId       String?
  name              String
  content           String
  category          String?
  tags              String[]
  isPublic          Boolean   @default(false)
  usageCount        Int       @default(0)
  isFavorite        Boolean   @default(false)

  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([isPublic])
}

model ConversationTemplate {
  id                String    @id @default(cuid())
  workspaceId       String?
  name              String
  description       String?
  initialMessages   Json
  category          String?
  isPublic          Boolean   @default(false)
  usageCount        Int       @default(0)

  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([isPublic])
}

model AIMemory {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  context           Json

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SharedConversation {
  id                String    @id @default(cuid())
  conversationId    String
  shareToken        String    @unique
  expiresAt         DateTime?
  isPublic          Boolean   @default(false)
  permissions       SharePermission @default(VIEW)

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([conversationId])
  @@index([shareToken])
}

enum SharePermission {
  VIEW
  COMMENT
  EDIT
}

model ConversationCollaborator {
  id                String    @id @default(cuid())
  conversationId    String
  userId            String
  role              CollaboratorRole

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId])
}

enum CollaboratorRole {
  VIEWER
  EDITOR
  OWNER
}

model ConversationActivity {
  id                String    @id @default(cuid())
  conversationId    String
  action            String
  metadata          Json?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([conversationId, createdAt])
}

model ConversationVersion {
  id                String    @id @default(cuid())
  conversationId    String
  content           Json

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([conversationId, createdAt])
}

// messageId/attempt/lastError added in M2 (Universal Conversation Engine)
// so retry support and error recovery are inspectable, not opaque:
// messageId links to the assistant Message this job produced (set only on
// success — see conversationGeneration.service.ts for why a Message row is
// never created until generation actually succeeds), attempt counts calls
// made so far, lastError holds the most recent failure's message.
model StreamingJob {
  id                String    @id @default(cuid())
  conversationId    String
  messageId         String?
  status            StreamingJobStatus @default(PENDING)
  attempt           Int       @default(0)
  lastError         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  @@index([conversationId])
  @@index([status])
}

enum StreamingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model Tool {
  id                String    @id @default(cuid())
  workspaceId       String?
  name              String
  description       String?
  definition        Json
  isPublic          Boolean   @default(false)

  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calls             ToolCall[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([isPublic])
}

// executedBy is a soft reference — same reasoning as AuditLog.actorId: a
// tool-execution audit trail must remain queryable even if the executing
// account is later removed. conversationId is a hard reference (cascade),
// matching ConversationActivity, since every call happens within a
// conversation's agent loop.
model ToolCall {
  id                String    @id @default(cuid())
  toolId            String
  conversationId    String
  executedBy        String
  input             Json
  output            Json?
  error             String?

  tool              Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([toolId])
  @@index([conversationId])
}

model ConversationUsage {
  id                String    @id @default(cuid())
  conversationId    String    @unique
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  totalTokens       Int       @default(0)
  estimatedCost     Float     @default(0)

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}
