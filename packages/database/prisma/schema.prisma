// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication Models
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          UserRole    @default(USER)
  status        UserStatus  @default(ACTIVE)

  // OAuth accounts
  accounts      Account[]

  // User data
  profile       UserProfile?
  preferences   UserPreferences?

  // Workspace membership
  workspaces    WorkspaceMember[]

  // Content & projects
  projects      Project[]
  documents     Document[]
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  audios        GeneratedAudio[]

  // Activity tracking
  activityLogs  ActivityLog[]

  // Auth sessions (refresh tokens)
  refreshTokens RefreshToken[]

  // Outstanding password-reset tokens
  passwordResetTokens PasswordResetToken[]

  // Outstanding email-verification tokens
  emailVerificationTokens EmailVerificationToken[]

  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastLoginAt   DateTime?

  // Login lockout: incremented on each failed password verification, reset
  // to 0 on a successful login. lockedUntil is set once the threshold is
  // reached and cleared on the next successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  @@index([status])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  bio           String?
  avatar        String?
  banner        String?
  website       String?
  location      String?
  socialLinks   Json?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model UserPreferences {
  id                String    @id @default(cuid())
  userId            String    @unique
  theme             Theme     @default(LIGHT)
  language          String    @default("en")
  emailNotifications Boolean   @default(true)
  pushNotifications Boolean   @default(false)
  marketingEmails   Boolean   @default(false)

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

enum Theme {
  LIGHT
  DARK
  AUTO
}

// Workspace Models
model Workspace {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  avatar        String?

  members       WorkspaceMember[]
  projects      Project[]
  apiKeys       ApiKey[]
  invitations   WorkspaceInvitation[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WorkspaceMember {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String
  role          WorkspaceRole @default(MEMBER)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
  VIEWER
}

model WorkspaceInvitation {
  id            String    @id @default(cuid())
  workspaceId   String
  email         String
  role          WorkspaceRole @default(MEMBER)
  token         String    @unique
  expiresAt     DateTime
  acceptedAt    DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([token])
}

model ApiKey {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  key           String    @unique
  lastUsedAt    DateTime?
  expiresAt     DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

// Project Models
model Project {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String?
  name          String
  description   String?
  status        ProjectStatus @default(ACTIVE)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  documents     Document[]
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  audios        GeneratedAudio[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// Content Models
model Document {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  title         String
  content       String
  format        DocumentFormat @default(MARKDOWN)
  status        ContentStatus @default(DRAFT)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

enum DocumentFormat {
  MARKDOWN
  HTML
  PLAIN_TEXT
  RICH_TEXT
}

model GeneratedImage {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  imageUrl      String
  thumbnailUrl  String?
  width         Int
  height        Int
  model         String
  status        ContentStatus @default(COMPLETED)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([projectId])
}

model GeneratedVideo {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  videoUrl      String
  thumbnailUrl  String?
  duration      Int
  width         Int
  height        Int
  model         String
  status        ContentStatus @default(PROCESSING)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

model GeneratedAudio {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  audioUrl      String
  duration      Int
  model         String
  status        ContentStatus @default(PROCESSING)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

enum ContentStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
  PUBLISHED
}

// Activity Tracking
model ActivityLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  resource      String
  resourceId    String
  metadata      Json?
  ipAddress     String?
  userAgent     String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Session Management (for NextAuth)
model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  expires       DateTime

  createdAt     DateTime  @default(now())

  @@index([userId])
}

model VerificationToken {
  identifier    String
  token         String    @unique
  expires       DateTime

  @@unique([identifier, token])
}

// Refresh tokens for stateful, revocable sessions. The raw opaque token is
// never stored — only its SHA-256 hash — so a database read cannot mint a
// session. Rotation is enforced by revoking the presented token whenever a
// new one is issued; logout revokes the token, which is what makes "log out"
// actually end the session (the short-lived access token expires within
// minutes, and no new one can be minted without a live refresh token).
//
// userAgent/ipAddress/lastUsedAt are device-session metadata captured at
// issue time (and refreshed on rotation) so a signed-in user can see and
// individually revoke their active sessions ("this device", "logout
// everywhere"). rememberMe records which expiry policy produced this
// token's expiresAt, purely for display — it never changes verification.
model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  rememberMe  Boolean   @default(false)

  @@index([userId])
  @@index([expiresAt])
}

// Password-reset tokens. Same hash-at-rest discipline as RefreshToken:
// the raw token only ever appears in the reset email/link. Single-use
// (usedAt) and short-lived (expiresAt); consuming one revokes every
// active refresh token for the user.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Email-verification tokens. Same hash-at-rest discipline as
// PasswordResetToken: the raw token only ever appears in the verification
// email/link. Single-use (usedAt) and short-lived (expiresAt).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// MFA Audit Logging
// userId is a soft reference (no FK): audit records must survive user
// lifecycle changes and remain queryable for compliance retention windows.
model MFAAuditLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  metadata      Json?
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([timestamp])
}
