// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication Models
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          UserRole    @default(USER)
  status        UserStatus  @default(ACTIVE)

  // Set the first time the user completes (or explicitly skips) the
  // onboarding flow. Null means "never onboarded" — router uses this to
  // redirect a fresh user into /welcome instead of dropping them onto an
  // empty dashboard.
  onboardedAt   DateTime?

  // OAuth accounts
  accounts      Account[]

  // User data
  profile       UserProfile?
  preferences   UserPreferences?

  // Workspace membership
  workspaces    WorkspaceMember[]

  // API keys the user created (workspace-scoped, but attributed to creator
  // so audits can show who provisioned a machine credential).
  apiKeysCreated ApiKey[]

  // Content & projects
  projects      Project[]
  documents     Document[]
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  audios        GeneratedAudio[]

  // Activity tracking
  activityLogs  ActivityLog[]

  // Auth sessions (refresh tokens)
  refreshTokens RefreshToken[]

  // Outstanding password-reset tokens
  passwordResetTokens PasswordResetToken[]

  // Outstanding email-verification tokens
  emailVerificationTokens EmailVerificationToken[]

  // In-app notifications
  notifications Notification[]

  // Workspace invitations sent by this user
  sentInvitations WorkspaceInvitation[]

  // Folders created and assets uploaded by this user
  createdFolders  Folder[]
  uploadedAssets  Asset[]

  // Conversation folders created by this user
  conversationFolders ConversationFolder[]

  // Files uploaded to conversations by this user
  conversationFiles   ConversationFile[]

  // Memory system
  memories      Memory[]
  memoryAuditLogs MemoryAuditLog[]
  memoryExports MemoryExport[]

  // Tool calling engine
  createdTools      ToolDefinition[]
  toolExecutions    ToolExecution[] @relation("UserToolExecutions")
  toolAuditLogs     ToolAuditLog[]
  createdToolSecrets ToolSecret[]
  toolSecretAuditLogs ToolSecretAuditLog[]

  // Prompt & template creation
  createdPrompts    PromptTemplate[] @relation("CreatedPrompts")
  createdTemplates  ConversationTemplate[] @relation("CreatedTemplates")

  // Universal Search System
  searchQueries     SearchQuery[]
  savedSearches     SavedSearch[]

  // Continuous Learning Platform feedback
  messageFeedback   MessageFeedback[]
  conversationFeedback ConversationFeedback[]
  corrections       Correction[]
  preferredResponses PreferredResponse[]
  hallucinationReports HallucinationReport[]
  citationFeedback  CitationFeedback[]
  toolFeedback      ToolFeedback[]
  visionFeedback    VisionFeedback[]
  voiceFeedback     VoiceFeedback[]
  rewardSignals     RewardSignal[]
  privacyConsent    PrivacyConsent[]
  trainingConsent   TrainingConsent[]
  abAssignments     ABAssignment[]

  // Training dataset creation
  createdDatasets   Dataset[] @relation("DatasetCreator")

  // Multi-factor authentication
  mfaMethods     MFAMethod[]
  mfaChallenges  MFAChallengeToken[]
  mfaSetupTokens MFASetupToken[]

  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastLoginAt   DateTime?

  // Login lockout: incremented on each failed password verification, reset
  // to 0 on a successful login. lockedUntil is set once the threshold is
  // reached and cleared on the next successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  @@index([status])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  bio           String?
  avatar        String?
  banner        String?
  website       String?
  location      String?
  socialLinks   Json?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model UserPreferences {
  id                String    @id @default(cuid())
  userId            String    @unique
  theme             Theme     @default(LIGHT)
  language          String    @default("en")
  emailNotifications Boolean   @default(true)
  pushNotifications Boolean   @default(false)
  marketingEmails   Boolean   @default(false)

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

enum Theme {
  LIGHT
  DARK
  AUTO
}

// Workspace Models
model Workspace {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  avatar        String?

  members       WorkspaceMember[]
  projects      Project[]
  apiKeys       ApiKey[]
  invitations   WorkspaceInvitation[]
  folders       Folder[]
  assets        Asset[]
  auditLogs     AuditLog[]

  // Billing relations (M6)
  subscription  Subscription?
  invoices      Invoice[]
  refunds       Refund[]
  paymentMethods PaymentMethod[]
  credits       WorkspaceCredits?
  creditLedger  CreditLedgerEntry[]
  usageRecords  UsageRecord[]

  // Release 3: Chat relations
  conversations       Conversation[]
  conversationFolders ConversationFolder[]
  conversationTags    ConversationTag[]
  conversationFiles   ConversationFile[]
  aiMemory            AIMemory?
  promptTemplates     PromptTemplate[]
  conversationTemplates ConversationTemplate[]
  tools               Tool[]

  // Release 3: Universal Memory System
  memories            Memory[]
  memoryQuota         MemoryQuota?
  memoryExports       MemoryExport[]

  // Release 3: Universal Tool Calling Engine
  toolDefinitions     ToolDefinition[]
  toolExecutions      ToolExecution[]
  toolQuota           ToolQuota?
  toolSecrets         ToolSecret[]
  toolSecretAuditLogs ToolSecretAuditLog[]

  // Release 3: Universal Search System
  searchIndices       SearchIndex[]
  searchQueries       SearchQuery[]
  savedSearches       SavedSearch[]
  searchSuggestions   SearchSuggestion[]
  searchRankings      SearchRanking[]
  searchAnalytics     SearchAnalytics[]

  // Continuous Learning Platform feedback
  messageFeedback     MessageFeedback[]
  conversationFeedback ConversationFeedback[]
  workspaceFeedback   WorkspaceFeedback?
  corrections         Correction[]
  preferredResponses  PreferredResponse[]
  hallucinationReports HallucinationReport[]
  citationFeedback    CitationFeedback[]
  toolFeedback        ToolFeedback[]
  visionFeedback      VisionFeedback[]
  voiceFeedback       VoiceFeedback[]
  rewardSignals       RewardSignal[]
  abExperiments       ABExperiment[]
  abAssignments       ABAssignment[]
  benchmarkRuns       BenchmarkRun[]
  evaluationRuns      EvaluationRun[]
  humanPreferences    HumanPreference[]
  privacyConsent      PrivacyConsent[]
  trainingConsent     TrainingConsent[]
  feedbackAnalytics   FeedbackAnalytics[]

  // Dataset management
  datasets            Dataset[]
  trainingCandidates  TrainingCandidate[]
  trainingExports     TrainingExport[]
  modelRegistry       ModelRegistry[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WorkspaceMember {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String
  role          WorkspaceRole @default(MEMBER)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
  VIEWER
}

model WorkspaceInvitation {
  id            String    @id @default(cuid())
  workspaceId   String
  email         String
  role          WorkspaceRole @default(MEMBER)
  token         String    @unique
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy     User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([token])
}

model ApiKey {
  id            String    @id @default(cuid())
  workspaceId   String
  createdById   String?
  name          String
  /// SHA-256 hash of the full secret. Deterministic so lookup by presented
  /// key stays a single indexed WHERE — the raw key has enough entropy that
  /// hashing it with SHA-256 (instead of bcrypt) offers no meaningful
  /// advantage to an attacker who leaks the DB row.
  key           String    @unique
  /// Non-secret display prefix (e.g. "sk_syn_abc12345") — shown in the UI so
  /// users can distinguish keys without ever seeing the secret again.
  prefix        String    @unique
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy     User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

// Project Models
model Project {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String?
  name          String
  description   String?
  status        ProjectStatus @default(ACTIVE)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  /// What the person is trying to accomplish, in their words. Distinct from
  /// `description`, which says what the project IS: a goal says what "done"
  /// would look like, and is what lets a project report progress against
  /// something rather than merely holding files.
  goal          String?

  documents     Document[]
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  audios        GeneratedAudio[]
  folders       Folder[]
  assets        Asset[]
  /// A project holds the work, not only its outputs. Conversations are
  /// where most of the thinking happens, so a project that could not hold
  /// them was a filing cabinet rather than a project.
  conversations Conversation[]

  /// Per-viewer "last opened" timestamps — see ProjectVisit below. Plural
  /// because a shared workspace project is opened by more than one person,
  /// each with their own sense of what's new since they were last here.
  visits        ProjectVisit[]

  /// Decision notes — see ProjectNote below.
  notes         ProjectNote[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

/// When a person last opened a project's workspace view — purely a
/// per-viewer timestamp, not a fact about the project itself. It exists so
/// returning to a project after time away can say what changed since THIS
/// person was last here ("continue work months later without starting
/// from zero") instead of handing back the same undifferentiated timeline
/// whether someone left for an hour or a quarter.
///
/// Deliberately NOT related to User by an explicit relation field, mirroring
/// ConversationCollaborator's userId: a plain column, not a foreign key,
/// so this table needs no reverse array on the User model.
model ProjectVisit {
  id           String   @id @default(cuid())
  projectId    String
  userId       String

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  lastViewedAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
}

/// A person's own record of why a decision was made — "I want Synora to
/// remember why we made a decision," answered the honest way: by giving
/// someone a place to write it down themselves, rather than an AI
/// summarizing or inferring a rationale nobody actually stated. Content is
/// exactly what was typed, shown verbatim in the project's timeline
/// alongside everything else that happened — never rewritten, condensed,
/// or interpreted.
///
/// `userId` is a plain column, not an owning relation, mirroring
/// ProjectVisit and ConversationCollaborator above — the author's display
/// name is resolved by a separate lookup when the timeline is built, the
/// same way agent and workflow names are resolved for run entries.
model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  content   String

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

// A folder organizes assets within a workspace, optionally scoped to a
// single project and optionally nested under a parent folder. Deleting a
// folder cascades to its subfolders (recursive folder semantics) but only
// detaches (never deletes) the assets inside it — see Asset.folder below.
model Folder {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String?
  parentId      String?
  name          String
  createdById   String

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      Folder[]  @relation("FolderChildren")
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  assets        Asset[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([parentId])
}

// A generic uploaded file, distinct from the AI-generated content models
// above (GeneratedImage/Video/Audio) — an Asset is something a member
// uploaded, not something Synora produced. Stored via the same
// provider-agnostic storage abstraction used for avatars.
model Asset {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String?
  folderId      String?
  name          String
  url           String
  key           String
  mimeType      String
  size          Int
  uploadedById  String

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([folderId])
}

// Per-workspace audit trail for permission-sensitive actions (member
// invited/removed/role-changed, project/folder/asset lifecycle, workspace
// settings changes). actorId is a soft reference — same reasoning as
// MFAAuditLog: the trail must remain queryable even if the actor's account
// is later removed.
model AuditLog {
  id            String    @id @default(cuid())
  workspaceId   String
  actorId       String
  action        String
  targetType    String
  targetId      String?
  metadata      Json?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// Content Models
model Document {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  title         String
  content       String
  format        DocumentFormat @default(MARKDOWN)
  status        ContentStatus @default(DRAFT)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

enum DocumentFormat {
  MARKDOWN
  HTML
  PLAIN_TEXT
  RICH_TEXT
}

model GeneratedImage {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  imageUrl      String
  thumbnailUrl  String?
  width         Int
  height        Int
  model         String
  status        ContentStatus @default(COMPLETED)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([projectId])
}

model GeneratedVideo {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  videoUrl      String
  thumbnailUrl  String?
  duration      Int
  width         Int
  height        Int
  model         String
  status        ContentStatus @default(PROCESSING)
  // The provider's own job/prediction ID (e.g. a Replicate prediction id),
  // required to poll that job later — this is NOT the same as our own `id`.
  providerJobId String?
  pollAttempts  Int       @default(0)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

model GeneratedAudio {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  audioUrl      String
  duration      Int
  model         String
  status        ContentStatus @default(PROCESSING)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

enum ContentStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
  PUBLISHED
}

// Activity Tracking
model ActivityLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  resource      String
  resourceId    String
  metadata      Json?
  ipAddress     String?
  userAgent     String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Session Management (for NextAuth)
model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  expires       DateTime

  createdAt     DateTime  @default(now())

  @@index([userId])
}

model VerificationToken {
  identifier    String
  token         String    @unique
  expires       DateTime

  @@unique([identifier, token])
}

// Refresh tokens for stateful, revocable sessions. The raw opaque token is
// never stored — only its SHA-256 hash — so a database read cannot mint a
// session. Rotation is enforced by revoking the presented token whenever a
// new one is issued; logout revokes the token, which is what makes "log out"
// actually end the session (the short-lived access token expires within
// minutes, and no new one can be minted without a live refresh token).
//
// userAgent/ipAddress/lastUsedAt are device-session metadata captured at
// issue time (and refreshed on rotation) so a signed-in user can see and
// individually revoke their active sessions ("this device", "logout
// everywhere"). rememberMe records which expiry policy produced this
// token's expiresAt, purely for display — it never changes verification.
model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  rememberMe  Boolean   @default(false)

  @@index([userId])
  @@index([expiresAt])
}

// Password-reset tokens. Same hash-at-rest discipline as RefreshToken:
// the raw token only ever appears in the reset email/link. Single-use
// (usedAt) and short-lived (expiresAt); consuming one revokes every
// active refresh token for the user.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Email-verification tokens. Same hash-at-rest discipline as
// PasswordResetToken: the raw token only ever appears in the verification
// email/link. Single-use (usedAt) and short-lived (expiresAt).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// In-app notifications. Created at real event trigger points alongside the
// corresponding transactional email (password changed/reset, email
// verified, workspace created) — never fabricated for display purposes.
model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationType {
  SECURITY
  ACCOUNT
  WORKSPACE
  SYSTEM
  BILLING
}

// MFA Audit Logging
// userId is a soft reference (no FK): audit records must survive user
// lifecycle changes and remain queryable for compliance retention windows.
model MFAAuditLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  metadata      Json?
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// Multi-factor authentication (TOTP)
//
// MFAMethod holds the per-user enrolled factor; MFASetupToken and
// MFAChallengeToken are short-lived, single-use handles for the enrollment
// and login-challenge flows respectively (both stored hashed, never raw).
// MFAAttempt and MFARecoveryCode back rate limiting and account recovery.
// Operational telemetry lives in MFAAuditLog above.
// ---------------------------------------------------------------------------

model MFAMethod {
  id              String    @id @default(cuid())
  userId          String
  type            MFAType   @default(TOTP)
  status          MFAStatus @default(SETUP_PENDING)

  // TOTP-specific (encrypted)
  secret          String?
  backupCodesHash String[]

  // Metadata
  deviceName      String?
  createdAt       DateTime  @default(now())
  enabledAt       DateTime?
  lastUsedAt      DateTime?

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts        MFAAttempt[]
  recoveryCodes   MFARecoveryCode[]

  @@unique([userId, type])
  @@index([userId])
  @@index([status])
}

model MFAAttempt {
  id              String    @id @default(cuid())
  mfaMethodId     String
  sessionId       String?
  ipAddress       String?
  userAgent       String?
  code            String?
  success         Boolean
  createdAt       DateTime  @default(now())

  mfaMethod       MFAMethod @relation(fields: [mfaMethodId], references: [id], onDelete: Cascade)

  @@index([mfaMethodId])
  @@index([createdAt])
  @@index([success])
  @@index([mfaMethodId, createdAt])
}

model MFAChallengeToken {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  sessionId       String?
  ipAddress       String?
  userAgent       String?
  /// Carries the login screen's "remember me" choice across the second-factor
  /// step, so the session issued after verification matches what was asked for.
  rememberMe      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  usedAt          DateTime?

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([userId, createdAt])
}

model MFARecoveryCode {
  id              String    @id @default(cuid())
  mfaMethodId     String
  codeHash        String    @unique
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  mfaMethod       MFAMethod @relation(fields: [mfaMethodId], references: [id], onDelete: Cascade)

  @@index([mfaMethodId])
  @@index([usedAt])
  @@index([mfaMethodId, createdAt])
}

model MFASetupToken {
  id              String    @id @default(cuid())
  userId          String
  tokenHash       String    @unique
  secret          String
  verified        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

enum MFAType {
  TOTP
}

enum MFAStatus {
  SETUP_PENDING
  ACTIVE
  DISABLED
  RECOVERY_MODE
}

// Billing Models
// Admin-editable plan catalog. Each plan defines pricing, credits, trial period,
// and feature set. One plan marked as default for new workspaces.
model Plan {
  id                String      @id @default(cuid())
  key               String      @unique
  name              String
  status            PlanStatus  @default(ACTIVE)
  interval          BillingInterval
  priceCents        Int
  creditsPerInterval Int         @default(0)
  trialDays         Int?
  features          Json?
  isDefault         Boolean     @default(false)
  sortOrder         Int         @default(0)
  providerPriceIds  Json?

  subscriptions     Subscription[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([isDefault])
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

// Exactly one subscription per workspace. Tracks the current plan,
// subscription status, billing periods, and external provider IDs.
model Subscription {
  id                      String              @id @default(cuid())
  workspaceId             String              @unique
  planId                  String
  provider                String?
  externalCustomerId      String?
  externalSubscriptionId  String?
  status                  SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean             @default(false)
  trialEndsAt             DateTime?
  // Dunning tracking: set on the first invoice.payment_failed after a
  // healthy period, cleared on the next successful payment/status
  // transition away from PAST_DUE. Lets support see how long a workspace
  // has actually been struggling, not just that it currently is.
  pastDueSince            DateTime?
  paymentFailureCount     Int                 @default(0)

  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                    Plan                @relation(fields: [planId], references: [id])

  invoices                Invoice[]
  paymentMethods          PaymentMethod[]

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([workspaceId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIAL
}

// Invoice records synced from the payment provider via webhooks.
// Only reads come from local DB; external-sync happens via webhooks only.
model Invoice {
  id                String          @id @default(cuid())
  subscriptionId    String
  workspaceId       String
  provider          String
  externalInvoiceId String          @unique
  status            InvoiceStatus
  amountDueCents    Int
  amountPaidCents   Int
  currency          String          @default("USD")
  hostedInvoiceUrl  String?
  periodStart       DateTime?
  periodEnd         DateTime?
  issuedAt          DateTime?
  paidAt            DateTime?
  // Running total of amounts refunded against this invoice. Stripe itself
  // does not change an invoice's own status on refund (the refund lives on
  // the underlying charge), so this is the local source of truth for
  // "how much of what was paid has since been returned" — fullyRefunded
  // is refundedAmountCents >= amountPaidCents, not a status value.
  refundedAmountCents Int           @default(0)

  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  refunds           Refund[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
  @@index([subscriptionId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

// Audit trail of refunds issued against a paid invoice. Multiple partial
// refunds against the same invoice are supported; Invoice.refundedAmountCents
// is the running total kept in sync with this table.
model Refund {
  id                String    @id @default(cuid())
  invoiceId         String
  workspaceId       String
  provider          String
  externalRefundId  String    @unique
  amountCents       Int
  reason            String
  actorId           String

  invoice           Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([invoiceId])
  @@index([workspaceId])
}

// Payment methods synced from provider via webhooks. Supports multiple
// payment methods per subscription; one marked as default.
model PaymentMethod {
  id                      String              @id @default(cuid())
  subscriptionId          String
  workspaceId             String
  provider                String
  externalPaymentMethodId String              @unique
  type                    PaymentMethodType
  brand                   String?
  last4                   String?
  expiryMonth             Int?
  expiryYear              Int?
  isDefault               Boolean             @default(false)

  subscription            Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([workspaceId])
  @@index([subscriptionId])
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  OTHER
}

// Credit balance per workspace. Denormalized for fast reads;
// source of truth for available balance.
model WorkspaceCredits {
  id            String          @id @default(cuid())
  workspaceId   String          @unique
  balance       Int             @default(0)
  updatedAt     DateTime        @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Append-only credit transaction log. Every grant, deduction, adjustment,
// expiration, or refund creates one entry. Never updated after creation.
model CreditLedgerEntry {
  id            String                  @id @default(cuid())
  workspaceId   String
  type          CreditTransactionType
  amount        Int
  balanceAfter  Int
  reason        String
  actorId       String?
  metadata      Json?
  createdAt     DateTime                @default(now())

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

enum CreditTransactionType {
  GRANT
  DEDUCTION
  ADJUSTMENT
  EXPIRATION
  REFUND
}

// Usage records for audit and future analytics. Records when capabilities
// are invoked and how many credits they consume. Callable today (M6),
// first call sites added in M7.
model UsageRecord {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String?
  capability    String
  quantity      Int       @default(1)
  creditsCost   Int
  metadata      Json?
  createdAt     DateTime  @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([capability, createdAt])
}

// Webhook event deduplication table. Prevents duplicate processing of
// the same webhook event replayed by the provider.
model ProcessedWebhookEvent {
  id            String    @id @default(cuid())
  provider      String
  externalEventId String

  createdAt     DateTime  @default(now())

  @@unique([provider, externalEventId])
  @@index([provider, createdAt])
}

// Release 3: Universal AI Workspace - Chat Models

model Conversation {
  id                String    @id @default(cuid())
  workspaceId       String
  /// Optional: a conversation may be filed into a project, gathering the
  /// thinking alongside the files and outputs it produced. SetNull rather
  /// than Cascade — deleting a project must never destroy the
  /// conversations someone had, only the grouping.
  projectId         String?
  title             String
  description       String?
  provider          String
  model             String
  status            ConversationStatus @default(ACTIVE)
  isArchived        Boolean   @default(false)
  isPinned          Boolean   @default(false)
  // Denormalized from the latest Message.createdAt in this conversation,
  // maintained by conversationGeneration.service.ts (M2) — avoids a
  // correlated subquery/join for the default "most recently active first"
  // list sort. Null until the first message is sent.
  lastMessageAt     DateTime?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  messages          Message[]
  folder            ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId          String?
  tags              ConversationTag[]
  collaborators     ConversationCollaborator[]
  versions          ConversationVersion[]
  activity          ConversationActivity[]
  shared            SharedConversation[]
  usage             ConversationUsage?
  toolCalls         ToolCall[]
  toolExecutions    ToolExecution[]
  memories          Memory[]
  files             ConversationFile[]

  // Continuous Learning Platform feedback
  messageFeedback   MessageFeedback[]
  conversationFeedback ConversationFeedback[]
  corrections       Correction[]
  preferredResponses PreferredResponse[]
  hallucinationReports HallucinationReport[]
  citationFeedback  CitationFeedback[]
  toolFeedback      ToolFeedback[]
  visionFeedback    VisionFeedback[]
  voiceFeedback     VoiceFeedback[]
  rewardSignals     RewardSignal[]
  abAssignments     ABAssignment[]
  abResults         ABResult[]
  trainingConsent   TrainingConsent[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, lastMessageAt])
  @@index([isArchived])
  @@index([isPinned])
  /// Reading one project's conversations is the project page's main query.
  @@index([projectId])
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// deletedAt follows the same nullable-timestamp soft-delete convention as
// RefreshToken.revokedAt/WorkspaceInvitation.revokedAt (presence = deleted,
// value = when) rather than introducing a new isDeleted-boolean pattern.
// Added in M1 specifically so M3 (message lifecycle) can implement soft
// delete without a further migration: the architecture calls for deleting a
// message to orphan, not cascade-remove, its children, which soft-delete
// naturally gives for free (a plain UPDATE never triggers the parentId FK's
// cascade — that only fires on an actual SQL DELETE, which soft-delete
// never issues).
model Message {
  id                String    @id @default(cuid())
  conversationId    String
  content           String
  role              MessageRole
  parentId          String?
  deletedAt         DateTime?
  isPinned          Boolean   @default(false)

  // Per-message accounting, written by the generation worker on completion.
  // Persisted (rather than only streamed over SSE) so counts survive reload
  // and so usage/analytics can aggregate without replaying streams.
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  costCents         Float     @default(0)
  provider          String?
  model             String?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent            Message?  @relation("MessageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Message[] @relation("MessageTree")

  branch            MessageBranch?
  attachments       MessageAttachment[]
  streamingJob      StreamingJob?

  // Continuous Learning Platform feedback
  feedback          MessageFeedback[]
  corrections       Correction[]
  preferredIn       PreferredResponse[] @relation("PreferredResponse")
  rejectedIn        PreferredResponse[] @relation("RejectedResponse")
  hallucinations    HallucinationReport[]
  citationFeedback  CitationFeedback[]
  toolFeedback      ToolFeedback[]
  visionFeedback    VisionFeedback[]
  voiceFeedback     VoiceFeedback[]
  rewardSignals     RewardSignal[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, deletedAt])
  @@index([conversationId, isPinned])
  @@index([parentId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model MessageBranch {
  id                String    @id @default(cuid())
  messageId         String    @unique
  branchIndex       Int
  isMainBranch      Boolean   @default(false)

  message           Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([messageId])
}

model MessageAttachment {
  id                String    @id @default(cuid())
  messageId         String
  url               String
  mimeType          String
  name              String
  size              Int

  message           Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([messageId])
}

// File uploads for conversation context
model ConversationFile {
  id                String          @id @default(cuid())
  conversationId    String
  workspaceId       String
  fileName          String
  mimeType          String
  fileSize          Int

  // Storage metadata
  storageKey        String          // S3 object key or local path
  storageProvider   String          @default("s3")  // s3, local, gcs, azure

  // Processing status
  processingStatus  FileProcessingStatus @default(PENDING)
  processingError   String?
  processedAt       DateTime?

  // Parsed content (for search/context)
  extractedText     String?         @db.Text

  // Virus scan
  virusScanStatus   VirusScanStatus @default(PENDING)
  virusScanError    String?

  // Metadata
  uploadedBy        String
  isArchived        Boolean         @default(false)

  conversation      Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedByUser    User            @relation(fields: [uploadedBy], references: [id])
  processingJob     FileProcessingJob?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([conversationId])
  @@index([workspaceId])
  @@index([uploadedBy])
  @@index([processingStatus])
  @@index([virusScanStatus])
}

enum FileProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum VirusScanStatus {
  PENDING
  SCANNING
  CLEAN
  INFECTED
  FAILED
}

// Background job for file processing
model FileProcessingJob {
  id                String    @id @default(cuid())
  fileId            String    @unique

  // Processing details
  status            FileProcessingStatus @default(PENDING)
  attempt           Int       @default(0)
  lastError         String?

  // Progress tracking
  progress          Float     @default(0)  // 0-100

  // Job timing
  startedAt         DateTime?
  completedAt       DateTime?

  file              ConversationFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([fileId])
}

model ConversationFolder {
  id                String    @id @default(cuid())
  workspaceId       String
  parentId          String?
  name              String
  createdById       String

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent            ConversationFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          ConversationFolder[] @relation("FolderTree")
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([parentId])
  @@index([createdById])
}

model ConversationTag {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String
  color             String?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  createdAt         DateTime  @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PromptTemplate {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String
  description       String?
  content           String
  category          String?
  tags              String[]
  isPublic          Boolean   @default(false)
  usageCount        Int       @default(0)
  rating            Float     @default(0)
  isFavorite        Boolean   @default(false)

  // Versioning
  parentId          String?
  parent            PromptTemplate? @relation(name: "PromptVersions", fields: [parentId], references: [id], onDelete: SetNull)
  children          PromptTemplate[] @relation(name: "PromptVersions")
  version           Int       @default(1)

  // Ownership
  createdBy         String
  creator           User      @relation(name: "CreatedPrompts", fields: [createdBy], references: [id], onDelete: Cascade)

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([createdBy])
  @@index([isPublic])
  @@index([category])
}

model ConversationTemplate {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String
  description       String?
  systemPrompt      String
  initialUserMessage String?
  suggestedFollowUps String[]
  category          String?
  isPublic          Boolean   @default(false)
  usageCount        Int       @default(0)

  // Ownership
  createdBy         String
  creator           User      @relation(name: "CreatedTemplates", fields: [createdBy], references: [id], onDelete: Cascade)

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([createdBy])
  @@index([isPublic])
  @@index([category])
}

model AIMemory {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  context           Json

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SharedConversation {
  id                String    @id @default(cuid())
  conversationId    String
  shareToken        String    @unique
  expiresAt         DateTime?
  isPublic          Boolean   @default(false)
  permissions       SharePermission @default(VIEW)

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([conversationId])
  @@index([shareToken])
}

enum SharePermission {
  VIEW
  COMMENT
  EDIT
}

model ConversationCollaborator {
  id                String    @id @default(cuid())
  conversationId    String
  userId            String
  role              CollaboratorRole

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId])
}

enum CollaboratorRole {
  VIEWER
  EDITOR
  OWNER
}

model ConversationActivity {
  id                String    @id @default(cuid())
  conversationId    String
  action            String
  metadata          Json?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([conversationId, createdAt])
}

model ConversationVersion {
  id                String    @id @default(cuid())
  conversationId    String
  content           Json

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([conversationId, createdAt])
}

// messageId/attempt/lastError added in M2 (Universal Conversation Engine)
// so retry support and error recovery are inspectable, not opaque:
// messageId links to the assistant Message this job produced (set only on
// success — see conversationGeneration.service.ts for why a Message row is
// never created until generation actually succeeds), attempt counts calls
// made so far, lastError holds the most recent failure's message.
model StreamingJob {
  id                String    @id @default(cuid())
  conversationId    String
  messageId         String?   @unique
  message           Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  status            StreamingJobStatus @default(PENDING)
  attempt           Int       @default(0)
  lastError         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  @@index([conversationId])
  @@index([status])
  @@index([conversationId, status])
}

enum StreamingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model Tool {
  id                String    @id @default(cuid())
  workspaceId       String?
  name              String
  description       String?
  definition        Json
  isPublic          Boolean   @default(false)

  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calls             ToolCall[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([isPublic])
}

// executedBy is a soft reference — same reasoning as AuditLog.actorId: a
// tool-execution audit trail must remain queryable even if the executing
// account is later removed. conversationId is a hard reference (cascade),
// matching ConversationActivity, since every call happens within a
// conversation's agent loop.
model ToolCall {
  id                String    @id @default(cuid())
  toolId            String
  conversationId    String
  executedBy        String
  input             Json
  output            Json?
  error             String?

  tool              Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([toolId])
  @@index([conversationId])
}

model ConversationUsage {
  id                String    @id @default(cuid())
  conversationId    String    @unique
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  totalTokens       Int       @default(0)
  estimatedCost     Float     @default(0)

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Universal Memory System (Release 3)
// Provider-independent long-term memory engine for conversations
// Supports billions of memory records across workspaces

model Memory {
  id                String          @id @default(cuid())
  workspaceId       String
  conversationId    String?
  userId            String

  // Content
  content           String
  summary           String?
  type              MemoryType
  category          String?
  tags              String[]        @default([])

  // Metadata
  importance        Float           @default(0.5)    // 0-1 score
  decayRate         Float           @default(0.01)   // Daily decay percentage
  lastAccessedAt    DateTime?
  accessCount       Int             @default(0)

  // Status
  isArchived        Boolean         @default(false)
  isPinned          Boolean         @default(false)
  isManual          Boolean         @default(true)   // vs auto-generated
  status            MemoryStatus    @default(ACTIVE)

  // Permissions
  permission        MemoryPermission @default(PRIVATE)
  sharedWith        String[]        @default([])     // userIds

  // Versioning & history
  version           Int             @default(1)
  parentId          String?         // Previous version
  parent            Memory?         @relation("MemoryVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions          Memory[]        @relation("MemoryVersions")

  // Relations
  relatedMemories   MemoryRelation[] @relation("MemoryFrom")
  relatedBy         MemoryRelation[] @relation("MemoryTo")

  // Embedding metadata (for vector DB)
  embeddingId       String?         // Vector DB record ID (Pinecone, Weaviate, etc.)
  embeddingModel    String?         // e.g., "text-embedding-3-small"
  embeddingVersion  Int             @default(0)
  embeddingRefreshNeeded Boolean    @default(false)

  // Encryption
  isEncrypted       Boolean         @default(false)
  encryptionKey     String?         @db.Text // Encrypted key reference

  // Lifecycle
  expiresAt         DateTime?

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  metadata          MemoryMetadata?
  auditLogs         MemoryAuditLog[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
  @@index([conversationId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([isPinned])
  @@index([importance])
  @@index([createdAt])
  @@index([workspaceId, conversationId, type])
  @@index([workspaceId, userId, status])
}

model MemoryMetadata {
  id                String    @id @default(cuid())
  memoryId          String    @unique

  // Memory type specific metadata
  source            String?   // Where memory came from (e.g., "conversation", "tool", "manual")
  context           Json?     // Context at time of creation
  confidence        Float     @default(1.0)  // How confident we are in this memory

  // Consolidation state
  isConsolidated    Boolean   @default(false)
  consolidatedAt    DateTime?
  consolidationScore Float?   // How well consolidated (0-1)

  // Metrics
  relevanceScore    Float     @default(1.0)
  retrievalCount    Int       @default(0)
  lastRetrievedAt   DateTime?

  // Analytics
  tokens            Int       @default(0)
  size              Int       @default(0)  // bytes

  memory            Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MemoryRelation {
  id                String    @id @default(cuid())
  fromId            String
  toId              String
  relationType      String    // "related_to", "references", "contradicts", "expands", etc.
  strength          Float     @default(1.0)  // 0-1 relation strength

  from              Memory    @relation("MemoryFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to                Memory    @relation("MemoryTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([fromId, toId, relationType])
  @@index([fromId])
  @@index([toId])
}

model MemoryAuditLog {
  id                String    @id @default(cuid())
  memoryId          String
  userId            String

  action            String    // "created", "updated", "accessed", "consolidated", "archived", "deleted", etc.
  changes           Json?     // What changed
  reason            String?
  metadata          Json?

  memory            Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([memoryId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model MemoryQuota {
  id                String    @id @default(cuid())
  workspaceId       String    @unique

  // Quotas (adjustable per plan)
  maxMemories       Int       @default(10000)
  maxTokens         Int       @default(1000000)
  maxStorage        BigInt    @default(1000000000)  // 1GB

  // Current usage
  currentMemories   Int       @default(0)
  currentTokens     Int       @default(0)
  currentStorage    BigInt    @default(0)

  // Limits
  maxConsolidationsPerDay Int @default(100)
  consolidationsUsedToday Int @default(0)
  lastResetAt       DateTime  @default(now())

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MemoryCache {
  id                String    @id @default(cuid())
  memoryId          String    @unique

  // Cache metadata
  cachedAt          DateTime  @default(now())
  expiresAt         DateTime
  hits              Int       @default(0)
  lastHitAt         DateTime?

  // Serialized content (Redis backup)
  serialized        String    @db.Text
}

enum MemoryType {
  // Duration-based
  SHORT_TERM        // Temporary, active context (minutes to hours)
  LONG_TERM         // Persistent knowledge (weeks to indefinite)

  // Knowledge-based
  SEMANTIC          // Facts, concepts, relationships
  EPISODIC          // Events, experiences, conversations

  // Scope-based
  WORKSPACE         // Workspace-level knowledge
  CONVERSATION      // Conversation-specific context

  // Management-based
  PINNED            // User explicitly pinned
  MANUAL            // User manually created
  AUTOMATIC         // System auto-generated from conversations/tools
}

enum MemoryStatus {
  ACTIVE            // Normal, retrievable
  ARCHIVED          // Hidden but preserved
  DELETED           // Soft-deleted, awaiting expiry
  EXPIRED           // TTL expired
  CONSOLIDATING     // Being consolidated/summarized
  DECAYING          // Importance below threshold
}

enum MemoryPermission {
  PRIVATE           // Only user can access
  WORKSPACE         // All workspace members can access
  SHARED            // Specific users can access
  PUBLIC            // All authenticated users can access
}

// Future workspace expansion
model MemoryExport {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String

  format            String    // "json", "markdown", "csv", etc.
  filteredBy        String?   // JSON query used to filter memories

  storageKey        String    // S3 or object storage path
  size              Int

  status            String    @default("pending")
  completedAt       DateTime?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([workspaceId])
  @@index([userId])
}

// Release 3: Universal Tool Calling Engine
// Production-grade tool execution platform with streaming, retry, circuit breaker, sandboxing

model ToolDefinition {
  id                String          @id @default(cuid())
  workspaceId       String?         // NULL for global tools
  name              String
  displayName       String
  description       String          @db.Text
  category          String          // e.g., "http", "database", "file", "python", "search"
  type              ToolType        // HTTP, GraphQL, Database, Search, File, Browser, Python, Webhook, MCP

  // Schema & Validation
  inputSchema       Json            // JSON Schema for input validation
  outputSchema      Json?           // JSON Schema for output validation

  // Configuration
  config            Json            // Provider-specific configuration
  secrets           String[]        @default([])  // Secret keys used by this tool

  // Capabilities & Permissions
  capabilities      String[]        @default([])  // e.g., ["read", "write", "execute"]
  permission        ToolPermission  @default(PRIVATE)
  allowedRoles      String[]        @default([])  // Empty = all roles allowed

  // Limits & Quotas
  maxParallelCalls  Int             @default(10)
  rateLimit         Int?            // Calls per minute, NULL = unlimited
  timeout           Int             @default(30000)  // ms
  maxRetries        Int             @default(3)

  // Flags
  isActive          Boolean         @default(true)
  isAsync           Boolean         @default(false)
  supportsStreaming Boolean         @default(false)
  requiresApproval  Boolean         @default(false)  // Human approval before execution

  // Versioning & History
  version           Int             @default(1)
  parentId          String?         // Previous version
  parent            ToolDefinition? @relation("ToolVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions          ToolDefinition[] @relation("ToolVersions")

  // Relations
  workspace         Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions        ToolExecution[]
  auditLogs         ToolAuditLog[]
  dependencies      ToolDependency[] @relation("ToolFrom")
  dependents        ToolDependency[] @relation("ToolTo")
  metrics           ToolMetrics?
  webhooks          ToolWebhook[]
  toolSecrets       ToolSecret[]
  toolFeedback      ToolFeedback[]

  createdBy         String?
  createdByUser     User?           @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  /// Set when a plugin contributed this tool, NULL when a person authored it.
  /// Provenance is a column rather than a naming convention because uninstall
  /// has to remove EXACTLY the plugin's tools: a contributed tool can reach a
  /// third-party host, and a rename that broke a string convention would
  /// leave that reach in place after the grant was withdrawn.
  pluginId          String?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([category])
  @@index([type])
  @@index([isActive])
  @@index([createdBy])
  @@index([workspaceId, pluginId])
}

enum ToolType {
  HTTP
  GraphQL
  Database
  Search
  File
  Browser
  Python
  Webhook
  MCP
  Custom
}

enum ToolPermission {
  PRIVATE         // Only tool owner
  WORKSPACE       // All workspace members
  SHARED          // Specific users
  PUBLIC          // All authenticated users
}

// Tool dependencies (e.g., Tool A depends on output of Tool B)
model ToolDependency {
  id                String          @id @default(cuid())
  fromId            String          // Tool that depends on output
  toId              String          // Tool that must run first

  // Dependency configuration
  passOutputAs      String?         // Parameter name to pass output to
  transformOutput   String?         // Optional JSON path/transform
  isOptional        Boolean         @default(false)

  from              ToolDefinition  @relation(name: "ToolFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to                ToolDefinition  @relation(name: "ToolTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

// Tool execution (call to a tool)
model ToolExecution {
  id                String          @id @default(cuid())
  toolId            String
  workspaceId       String
  conversationId    String?         // If called from conversation
  userId            String

  // Execution details
  input             Json
  output            Json?
  error             String?

  // Status & Progress
  status            ExecutionStatus @default(PENDING)
  progress          Float           @default(0)  // 0-100

  // Streaming (for long-running operations)
  isStreaming       Boolean         @default(false)
  streamStartedAt   DateTime?

  // Retry tracking
  attemptNumber     Int             @default(1)
  maxAttempts       Int             @default(3)
  lastError         String?

  // Circuit breaker state
  circuitBreakerOpen Boolean        @default(false)

  // Timing
  startedAt         DateTime?
  completedAt       DateTime?
  duration          Int?            // milliseconds

  // Cost tracking
  inputTokens       Int             @default(0)
  outputTokens      Int             @default(0)
  costCents         Int             @default(0)

  // Approval workflow
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?

  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User            @relation("UserToolExecutions", fields: [userId], references: [id], onDelete: Cascade)

  invocations       ToolInvocation[]
  auditLogs         ToolAuditLog[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([toolId])
  @@index([workspaceId])
  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
}

enum ExecutionStatus {
  PENDING           // Waiting to execute
  APPROVED          // Approved, waiting to run
  RUNNING           // Currently executing
  STREAMING         // Streaming response
  COMPLETED         // Successfully completed
  FAILED            // Failed with error
  CANCELLED         // User cancelled
  TIMEOUT           // Execution timeout
  REJECTED          // Approval rejected
}

// Individual tool invocation (atomic operation within execution)
model ToolInvocation {
  id                String          @id @default(cuid())
  executionId       String
  parentInvocationId String?        // For nested calls

  // Call details
  input             Json
  output            Json?
  error             String?

  // Status
  status            ExecutionStatus @default(PENDING)

  // Timing
  startedAt         DateTime?
  completedAt       DateTime?

  // Order (for parallel/sequential tracking)
  sequenceNumber    Int
  retryCount        Int             @default(0)

  execution         ToolExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  parent            ToolInvocation? @relation(name: "ToolInvocationTree", fields: [parentInvocationId], references: [id], onDelete: Cascade)
  children          ToolInvocation[] @relation(name: "ToolInvocationTree")

  createdAt         DateTime        @default(now())

  @@index([executionId])
  @@index([parentInvocationId])
}

// Tool execution audit log (immutable trail)
model ToolAuditLog {
  id                String          @id @default(cuid())
  toolId            String
  executionId       String?
  userId            String

  action            String          // "CREATED", "EXECUTED", "FAILED", "APPROVED", "REJECTED"
  status            String?

  changes           Json?           // For definition changes
  metadata          Json?           // Additional context

  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  execution         ToolExecution?  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@index([toolId])
  @@index([executionId])
  @@index([userId])
  @@index([action])
}

// Tool metrics (aggregated statistics)
model ToolMetrics {
  id                String          @id @default(cuid())
  toolId            String          @unique

  totalExecutions   Int             @default(0)
  successfulExecutions Int          @default(0)
  failedExecutions  Int             @default(0)

  avgDuration       Float           @default(0)
  minDuration       Int?
  maxDuration       Int?

  avgInputTokens    Float           @default(0)
  avgOutputTokens   Float           @default(0)
  totalCostCents    Int             @default(0)

  lastExecutedAt    DateTime?

  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([toolId])
}

// Webhook configuration for tool callbacks
model ToolWebhook {
  id                String          @id @default(cuid())
  toolId            String

  event             String          // "on-start", "on-progress", "on-complete", "on-error"
  url               String

  method            String          @default("POST")
  headers           Json?

  isActive          Boolean         @default(true)

  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@index([toolId])
  @@index([event])
}

// Tool workspace quota (limits per workspace)
model ToolQuota {
  id                String          @id @default(cuid())
  workspaceId       String          @unique

  // Usage limits
  maxToolsPerWorkspace Int          @default(100)
  maxExecutionsPerDay Int           @default(10000)
  maxCostPerMonth   Int             @default(100000)  // cents

  // Current usage (daily reset)
  executionsUsedToday Int           @default(0)
  costUsedThisMonth Int             @default(0)

  lastResetAt       DateTime        @default(now())

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
}

// Encrypted Tool Secrets (Release 3)
// Stores API keys, credentials, and other secrets for tool execution
model ToolSecret {
  id                String          @id @default(cuid())
  toolId            String
  workspaceId       String

  // Secret metadata
  name              String          // e.g., "api_key", "auth_token", "database_url"
  description       String?
  secretType        String          // API_KEY, PASSWORD, URL, TOKEN, CONNECTION_STRING, etc.

  // Encrypted value (AES-256-GCM)
  encryptedValue    String          @db.Text  // Base64-encoded ciphertext
  iv                String                    // Base64-encoded initialization vector
  authTag           String                    // Base64-encoded authentication tag
  algorithm         String          @default("aes-256-gcm")

  // Metadata
  expiresAt         DateTime?       // Optional expiration date
  isRotationPending Boolean         @default(false)
  lastRotatedAt     DateTime?

  // Relations
  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs         ToolSecretAuditLog[]

  createdBy         String
  createdByUser     User            @relation(fields: [createdBy], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([toolId, name])
  @@index([toolId])
  @@index([workspaceId])
  @@index([createdBy])
  @@index([expiresAt])
}

// Tool Secret Audit Log
// Immutable audit trail for all secret access and modifications
model ToolSecretAuditLog {
  id                String          @id @default(cuid())
  // Nullable + SetNull (not Cascade): this log is the immutable record that a
  // secret was deleted, so it must outlive the secret it describes — a
  // cascading FK would destroy the DELETED entry in the same transaction
  // that creates it.
  secretId          String?
  workspaceId       String

  // Action tracking
  action            String          // CREATED, RETRIEVED, UPDATED, ROTATED, DELETED, ACCESSED
  reason            String?         // Why was the secret accessed (for audit)

  // Access context
  accessedBy        String
  accessedByUser    User            @relation(fields: [accessedBy], references: [id])

  // Security context
  ipAddress         String?
  userAgent         String?
  requestId         String?         // Correlation ID from request middleware

  // Relations
  secret            ToolSecret?     @relation(fields: [secretId], references: [id], onDelete: SetNull)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@index([secretId])
  @@index([workspaceId])
  @@index([accessedBy])
  @@index([action])
  @@index([createdAt])
}

// Universal Search System (Release 3)
// Comprehensive multi-provider search with hybrid, full-text, and vector capabilities

model SearchIndex {
  id                String          @id @default(cuid())
  workspaceId       String
  resourceType      SearchResourceType  // CONVERSATION, MESSAGE, MEMORY, DOCUMENT
  resourceId        String

  // Content for indexing
  title             String?
  content           String          @db.Text
  summary           String?
  keywords          String[]        @default([])

  // Chunking for large documents
  chunkIndex        Int             @default(0)  // Which chunk this is
  totalChunks       Int             @default(1)  // Total chunks for this resource

  // Vector embedding metadata
  embeddingId       String?         // Vector DB ID (Pinecone, Weaviate, etc.)
  embeddingModel    String?         // e.g., "text-embedding-3-small"
  embeddingDimension Int?

  // Full-text search metadata
  tsvector          String?         @db.Text  // PostgreSQL tsvector for FTS

  // Workspace and resource isolation
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Metadata
  language          String          @default("en")
  isIndexed         Boolean         @default(false)
  indexedAt         DateTime?
  lastUpdatedAt     DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
  @@index([resourceType])
  @@index([resourceId])
  @@index([workspaceId, resourceType, resourceId])
  @@index([isIndexed])
  @@index([indexedAt])
}

enum SearchResourceType {
  CONVERSATION
  MESSAGE
  MEMORY
  DOCUMENT
  PROMPT_TEMPLATE
  CONVERSATION_TEMPLATE
}

model SearchQuery {
  id                String          @id @default(cuid())
  workspaceId       String
  userId            String

  query             String
  queryType         SearchQueryType // HYBRID, FULLTEXT, VECTOR, SEMANTIC

  // Results metadata
  resultCount       Int             @default(0)
  executionTimeMs   Int             @default(0)

  // Analytics
  clickedResultId   String?         // Which result was clicked (if any)
  clickPosition     Int?            // Position in results
  isRelevant        Boolean?        // User feedback: was this relevant?

  // Rankings/ordering
  sortBy            String          @default("relevance")  // relevance, recent, popular

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@index([queryType])
}

enum SearchQueryType {
  HYBRID
  FULLTEXT
  VECTOR
  SEMANTIC
}

model SavedSearch {
  id                String          @id @default(cuid())
  workspaceId       String
  userId            String

  name              String
  description       String?
  query             String
  queryType         SearchQueryType @default(HYBRID)

  // Filters
  filters           Json?           // Saved filter configuration
  sortBy            String          @default("relevance")
  limit             Int             @default(20)

  // Pinning/favorites
  isPinned          Boolean         @default(false)
  pinnedOrder       Int?

  // Usage tracking
  executionCount    Int             @default(0)
  lastExecutedAt    DateTime?

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, userId, name])
  @@index([workspaceId])
  @@index([userId])
  @@index([isPinned])
}

model SearchSuggestion {
  id                String          @id @default(cuid())
  workspaceId       String

  term              String
  frequency         Int             @default(1)

  // Category
  type              SearchSuggestionType

  // Ranking
  popularity        Float           @default(0)  // 0-1 score

  // Cache management
  isActive          Boolean         @default(true)
  expiresAt         DateTime?

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, term])
  @@index([workspaceId])
  @@index([frequency])
  @@index([popularity])
}

enum SearchSuggestionType {
  QUERY       // Full query suggestions
  KEYWORD     // Single keyword suggestions
  FILTER      // Filter suggestions
  OPERATOR    // Search operator suggestions
}

model SearchRanking {
  id                String          @id @default(cuid())
  workspaceId       String
  resourceType      SearchResourceType

  // Ranking weights
  titleWeight       Float           @default(1.5)
  contentWeight     Float           @default(1.0)
  keywordWeight     Float           @default(1.2)
  recencyWeight     Float           @default(0.8)
  popularityWeight  Float           @default(0.6)
  importanceWeight  Float           @default(1.1)

  // Boosting
  boostRecent       Boolean         @default(true)  // Boost recently modified
  recentDaysThreshold Int           @default(7)
  recentBoost       Float           @default(1.3)

  // Personalization
  boostByUserInteraction Boolean    @default(true)

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, resourceType])
  @@index([workspaceId])
}

model SearchAnalytics {
  id                String          @id @default(cuid())
  workspaceId       String

  // Query metrics
  totalSearches     Int             @default(0)
  uniqueSearchers   Int             @default(0)
  avgExecutionTime  Float           @default(0)

  // Result metrics
  avgResultCount    Float           @default(0)
  clickThroughRate  Float           @default(0)

  // Most common queries
  topQueries        Json            // [{term: string, count: int}]
  topSearchers      Json            // [{userId: string, count: int}]

  // Performance metrics
  indexSize         BigInt          @default(0)
  cachedResultsHit  Int             @default(0)
  cachedResultsMiss Int             @default(0)

  // Time period
  periodStart       DateTime
  periodEnd         DateTime

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, periodStart, periodEnd])
  @@index([workspaceId])
}

// ============================================================================
// Release 3: Continuous Learning Platform
// Provider-agnostic feedback collection, dataset preparation, and model
// evolution infrastructure. Designed for training, evaluation, and A/B testing.
// ============================================================================

// Message-level feedback
model MessageFeedback {
  id                String                @id @default(cuid())
  messageId         String
  conversationId    String
  workspaceId       String
  userId            String

  // Feedback types
  rating            Int?                  // 1-5 star rating
  isHelpful         Boolean?              // Thumbs up/down
  thumbsUp          Boolean?              // Explicit positive reaction
  thumbsDown        Boolean?              // Explicit negative reaction

  // Detailed feedback
  feedbackType      MessageFeedbackType   // RATING, HELPFUL, UNHELPFUL, CORRECTION, etc.
  comment           String?               @db.Text

  // Feedback on specific aspects
  accuracyRating    Int?                  // 1-5 accuracy score
  clarityRating     Int?                  // 1-5 clarity score
  completenessRating Int?                 // 1-5 completeness score
  relevanceRating   Int?                  // 1-5 relevance score

  // Relations
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Audit
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([conversationId])
  @@index([workspaceId])
  @@index([userId])
  @@index([feedbackType])
  @@index([createdAt])
}

enum MessageFeedbackType {
  RATING
  HELPFUL
  UNHELPFUL
  CORRECTION
  HALLUCINATION
  TOXICITY
  BIAS
  INCOMPLETE
  IRRELEVANT
}

// Conversation-level feedback
model ConversationFeedback {
  id                String                @id @default(cuid())
  conversationId    String
  workspaceId       String
  userId            String

  // Overall feedback
  overallRating     Int?                  // 1-5 star rating
  isUseful          Boolean?

  // Detailed metrics
  qualityScore      Int?                  // 1-100
  satisfactionScore Int?                  // 1-100

  // Text feedback
  comment           String?               @db.Text

  // Feedback on aspects
  relevanceRating   Int?
  coherenceRating   Int?
  usefulnessRating  Int?

  // Relations
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
}

// Workspace-level feedback aggregates
model WorkspaceFeedback {
  id                String                @id @default(cuid())
  workspaceId       String                @unique

  // Aggregated metrics
  averageRating     Float                 @default(0)
  totalRatings      Int                   @default(0)

  // Quality metrics
  averageQualityScore Float               @default(0)
  averageSatisfactionScore Float           @default(0)

  // Feedback distribution
  positiveCount     Int                   @default(0)
  neutralCount      Int                   @default(0)
  negativeCount     Int                   @default(0)

  // Common issues
  topIssues         Json?                 // [{issue: string, count: int}]

  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([workspaceId])
}

// Response corrections and alternatives
model Correction {
  id                String                @id @default(cuid())
  messageId         String
  conversationId    String
  workspaceId       String
  userId            String

  // Original vs corrected
  originalContent   String                @db.Text
  correctedContent  String                @db.Text
  reason            String?               @db.Text

  // Correction type
  correctionType    CorrectionType
  confidence        Float?                // 0-1 confidence in correction

  // Relations
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([messageId])
  @@index([conversationId])
  @@index([workspaceId])
  @@index([correctionType])
}

enum CorrectionType {
  FACTUAL_ERROR
  GRAMMAR
  CLARITY
  TONE
  COMPLETENESS
  STYLE
  TECHNICAL
  OTHER
}

// Pairwise preferences (for DPO training)
model PreferredResponse {
  id                String                @id @default(cuid())
  conversationId    String
  workspaceId       String
  userId            String

  // The two responses being compared
  preferredMessageId String
  rejectedMessageId  String

  // Reason for preference
  reason            String?               @db.Text
  preferenceType    PreferenceType

  // Confidence
  confidence        Float?                // 0-1

  // Relations
  preferredMessage  Message               @relation(name: "PreferredResponse", fields: [preferredMessageId], references: [id], onDelete: Cascade)
  rejectedMessage   Message               @relation(name: "RejectedResponse", fields: [rejectedMessageId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([conversationId])
  @@index([workspaceId])
  @@index([preferenceType])
}

enum PreferenceType {
  ACCURACY
  CLARITY
  HELPFULNESS
  RELEVANCE
  STYLE
  TONE
  COMPLETENESS
  SAFETY
}

// Hallucination reports
model HallucinationReport {
  id                String                @id @default(cuid())
  messageId         String
  conversationId    String
  workspaceId       String
  userId            String

  // What was hallucinated
  hallucinatedText  String                @db.Text
  factualCorrection String                @db.Text

  // Hallucination severity
  severity          HallucinationSeverity
  category          HallucinationCategory

  // Supporting evidence
  evidence          String?               @db.Text
  sourceUrl         String?

  // Relations
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([messageId])
  @@index([conversationId])
  @@index([severity])
  @@index([category])
}

enum HallucinationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HallucinationCategory {
  FACTUAL_ERROR
  FALSE_CITATION
  INVENTED_INFORMATION
  OUTDATED_INFORMATION
  LOGICAL_ERROR
}

// Citation quality feedback
model CitationFeedback {
  id                String                @id @default(cuid())
  messageId         String
  conversationId    String
  workspaceId       String
  userId            String

  // Citation being reviewed
  citedText         String                @db.Text
  sourceUrl         String?
  isAccurate        Boolean?
  isCitable         Boolean?

  // Quality assessment
  qualityScore      Int?                  // 1-5
  relevanceScore    Int?                  // 1-5

  comment           String?               @db.Text

  // Relations
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([messageId])
  @@index([conversationId])
  @@index([isAccurate])
}

// Tool execution feedback
model ToolFeedback {
  id                String                @id @default(cuid())
  messageId         String?               // Message containing tool use
  conversationId    String
  workspaceId       String
  userId            String
  toolId            String

  // Feedback
  isSuccessful      Boolean?
  isCorrect         Boolean?
  rating            Int?                  // 1-5

  // Details
  comment           String?               @db.Text
  errorDescription  String?               @db.Text

  // Relations
  message           Message?              @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool              ToolDefinition        @relation(fields: [toolId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([messageId])
  @@index([conversationId])
  @@index([toolId])
}

// Vision task feedback
model VisionFeedback {
  id                String                @id @default(cuid())
  messageId         String
  conversationId    String
  workspaceId       String
  userId            String

  // Image analysis feedback
  detectionAccuracy Int?                  // 1-5
  descriptionQuality Int?                // 1-5
  relevance         Int?                  // 1-5

  // Issues found
  missedElements    String[]              @default([])
  incorrectElements String[]              @default([])

  comment           String?               @db.Text

  // Relations
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([messageId])
  @@index([conversationId])
}

// Voice/audio task feedback
model VoiceFeedback {
  id                String                @id @default(cuid())
  messageId         String
  conversationId    String
  workspaceId       String
  userId            String

  // Audio quality feedback
  transcriptionAccuracy Int?              // 1-5
  synthesiQuality   Int?                  // 1-5
  pronunciationQuality Int?               // 1-5

  // Issues
  errors            String[]              @default([])
  comment           String?               @db.Text

  // Relations
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([messageId])
  @@index([conversationId])
}

// Dataset for training
model Dataset {
  id                String                @id @default(cuid())
  workspaceId       String
  name              String
  description       String?               @db.Text

  // Dataset purpose
  datasetType       DatasetType           // RLHF, DPO, SFT, etc.
  purpose           String?               // "Claude 3.5 Sonnet SFT", etc.

  // Versioning
  version           String                @default("1.0")
  parentDatasetId   String?
  parent            Dataset?              @relation("DatasetVersions", fields: [parentDatasetId], references: [id], onDelete: SetNull)
  children          Dataset[]             @relation("DatasetVersions")

  // Access control
  isPublic          Boolean               @default(false)
  createdBy         String
  creator           User                  @relation(name: "DatasetCreator", fields: [createdBy], references: [id])

  // Metadata
  sampleCount       Int                   @default(0)
  totalTokens       Int                   @default(0)

  // Status
  status            DatasetStatus         @default(DRAFT)

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  samples           DatasetSample[]
  versions          DatasetVersion[]
  exports           TrainingExport[]
  evaluationRuns    EvaluationRun[]
  humanPreferences  HumanPreference[]
  trainingCandidates TrainingCandidate[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([workspaceId])
  @@index([datasetType])
  @@index([status])
  @@index([createdBy])
}

enum DatasetType {
  RLHF
  DPO
  SFT
  TOOL_USE
  REASONING
  CODE_GENERATION
  VISION
  MULTIMODAL
  EVALUATION
  BENCHMARK
}

enum DatasetStatus {
  DRAFT
  PROCESSING
  READY
  ARCHIVED
  DELETED
}

// Dataset version tracking
model DatasetVersion {
  id                String                @id @default(cuid())
  datasetId         String
  versionNumber     Int
  versionName       String?
  changeLog         String?               @db.Text

  // Snapshot metadata
  sampleCount       Int
  totalTokens       Int
  checksum          String                // For integrity verification

  // Relations
  dataset           Dataset               @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  samples           DatasetSample[]

  createdAt         DateTime              @default(now())

  @@unique([datasetId, versionNumber])
  @@index([datasetId])
}

// Individual samples in a dataset
model DatasetSample {
  id                String                @id @default(cuid())
  datasetId         String
  datasetVersionId  String?

  // Source tracking
  sourceType        SampleSourceType      // MESSAGE, CONVERSATION, FEEDBACK, SYNTHETIC
  sourceId          String?               // messageId, conversationId, etc.

  // Sample content
  input             String                @db.Text
  output            String                @db.Text

  // Metadata
  inputTokens       Int
  outputTokens      Int

  // Quality metrics
  qualityScore      Float?                // 0-1
  confidence        Float?                // 0-1

  // Flags
  isFiltered        Boolean               @default(false)
  filterReason      String?
  hasPII            Boolean               @default(false)
  isUnsafe          Boolean               @default(false)

  // Relations
  dataset           Dataset               @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  version           DatasetVersion?       @relation(fields: [datasetVersionId], references: [id], onDelete: SetNull)
  labels            DatasetLabel[]
  splits            DatasetSplit[]

  createdAt         DateTime              @default(now())

  @@index([datasetId])
  @@index([sourceType])
  @@index([qualityScore])
  @@index([hasPII])
}

enum SampleSourceType {
  MESSAGE
  CONVERSATION
  FEEDBACK
  CORRECTION
  PREFERENCE
  SYNTHETIC
  EXTERNAL
}

// Labels on dataset samples
model DatasetLabel {
  id                String                @id @default(cuid())
  sampleId          String
  labelType         String                // "intent", "sentiment", "topic", etc.
  labelValue        String
  confidence        Float?                // 0-1 confidence in label

  sample            DatasetSample         @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([sampleId])
  @@index([labelType])
}

// Train/val/test splits
model DatasetSplit {
  id                String                @id @default(cuid())
  sampleId          String
  splitType         SplitType
  splitPercentage   Float                 // For reproducibility

  sample            DatasetSample         @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([sampleId, splitType])
  @@index([sampleId])
}

enum SplitType {
  TRAIN
  VALIDATION
  TEST
  HOLDOUT
}

// Evaluation run (benchmark)
model EvaluationRun {
  id                String                @id @default(cuid())
  workspaceId       String
  datasetId         String

  // Model being evaluated
  modelId           String
  modelVersion      String

  // Evaluation config
  evaluationType    EvaluationType
  metrics           String[]              @default([])

  // Results
  status            EvaluationStatus      @default(PENDING)
  progress          Float                 @default(0)

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataset           Dataset               @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  results           EvaluationResult[]

  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())

  @@index([workspaceId])
  @@index([datasetId])
  @@index([status])
}

enum EvaluationType {
  ACCURACY
  PERPLEXITY
  BLEU
  ROUGE
  F1
  CUSTOM
}

enum EvaluationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Evaluation results
model EvaluationResult {
  id                String                @id @default(cuid())
  evaluationRunId   String
  sampleId          String

  // Prediction vs ground truth
  prediction        String                @db.Text
  groundTruth       String?               @db.Text

  // Scores
  score             Float                 // 0-1
  metrics           Json?                 // {accuracy: 0.95, precision: 0.92}

  // Errors
  error             String?
  errorType         String?

  evaluationRun     EvaluationRun         @relation(fields: [evaluationRunId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([evaluationRunId])
  @@index([score])
}

// Reward signals for RLHF
model RewardSignal {
  id                String                @id @default(cuid())
  conversationId    String
  messageId         String
  workspaceId       String
  userId            String

  // The signal
  reward            Float                 // Unbounded reward value
  rewardType        RewardType

  // Context
  comment           String?               @db.Text

  // Relations
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([conversationId])
  @@index([messageId])
  @@index([rewardType])
}

enum RewardType {
  THUMBS_UP
  THUMBS_DOWN
  RATING
  PREFERENCE
  CORRECTION
  CUSTOM
}

// Human preference pairs for DPO training
model HumanPreference {
  id                String                @id @default(cuid())
  datasetId         String
  workspaceId       String

  // Preference pair
  preferredSampleId String
  rejectedSampleId  String

  // Metadata
  annotatorId       String?
  confidence        Float?                // 0-1

  dataset           Dataset               @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([datasetId])
  @@index([workspaceId])
}

// A/B experiment configuration
model ABExperiment {
  id                String                @id @default(cuid())
  workspaceId       String
  name              String
  description       String?               @db.Text

  // Models being tested
  controlModelId    String
  treatmentModelId  String

  // Configuration
  status            ExperimentStatus      @default(DRAFT)
  targetSampleSize  Int
  currentSampleSize Int                   @default(0)

  // Dates
  startedAt         DateTime?
  endedAt           DateTime?

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignments       ABAssignment[]
  results           ABResult[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([workspaceId])
  @@index([status])
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  COMPLETED
  CANCELLED
}

// A/B assignment (which variant a user gets)
model ABAssignment {
  id                String                @id @default(cuid())
  experimentId      String
  conversationId    String
  workspaceId       String
  userId            String

  // Variant
  variant           String                // "control" or "treatment"

  // Relations
  experiment        ABExperiment          @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@unique([experimentId, conversationId])
  @@index([experimentId])
  @@index([variant])
}

// A/B result
model ABResult {
  id                String                @id @default(cuid())
  experimentId      String
  conversationId    String

  // Outcome
  variant           String
  outcome           String?               // win/loss/draw
  metricValue       Float?

  experiment        ABExperiment          @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([experimentId])
}

// Benchmark run
model BenchmarkRun {
  id                String                @id @default(cuid())
  workspaceId       String
  name              String

  // Models tested
  modelIds          String[]              @default([])

  // Benchmark datasets
  datasetIds        String[]              @default([])

  // Status
  status            BenchmarkStatus       @default(PENDING)
  progress          Float                 @default(0)

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  metrics           BenchmarkMetric[]

  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime              @default(now())

  @@index([workspaceId])
  @@index([status])
}

enum BenchmarkStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Benchmark metric results
model BenchmarkMetric {
  id                String                @id @default(cuid())
  benchmarkRunId    String

  // Model and dataset
  modelId           String
  datasetId         String

  // Metrics
  metricName        String
  metricValue       Float

  // Secondary metrics
  metadata          Json?

  benchmarkRun      BenchmarkRun          @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([benchmarkRunId])
  @@index([modelId])
  @@index([datasetId])
}

// Model registry for tracking versions and capabilities
model ModelRegistry {
  id                String                @id @default(cuid())
  workspaceId       String
  providerId        String                // "anthropic", "openai", etc.
  modelName         String                // "claude-3-opus", "gpt-4"

  // Model metadata
  description       String?               @db.Text
  capabilities      String[]              @default([])  // ["text", "vision", "tool_use"]

  // Versioning
  latestVersion     String?

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions          ModelVersion[]

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([workspaceId, providerId, modelName])
  @@index([workspaceId])
  @@index([providerId])
}

// Model version tracking
model ModelVersion {
  id                String                @id @default(cuid())
  modelId           String
  versionString     String

  // Training info
  trainingDatasetId String?
  trainingProgress  Float                 @default(0)

  // Performance
  benchmarkScores   Json?                 // {accuracy: 0.95, f1: 0.92}

  // Status
  status            ModelVersionStatus    @default(DRAFT)

  // Relations
  model             ModelRegistry         @relation(fields: [modelId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@unique([modelId, versionString])
  @@index([modelId])
  @@index([status])
}

enum ModelVersionStatus {
  DRAFT
  TRAINING
  EVALUATING
  RELEASED
  DEPRECATED
}

// Training candidate (a model ready for training)
model TrainingCandidate {
  id                String                @id @default(cuid())
  workspaceId       String
  datasetId         String
  modelName         String

  // Training config
  hyperparameters   Json                  // {lr: 0.0001, batch_size: 32}
  algorithm         String                // "sft", "dpo", "rlhf"

  // Status
  status            CandidateStatus       @default(PENDING)
  priority          Int                   @default(0)  // 0 = lowest, 100 = highest

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  dataset           Dataset               @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())

  @@index([workspaceId])
  @@index([status])
  @@index([priority])
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

// Training data export
model TrainingExport {
  id                String                @id @default(cuid())
  datasetId         String
  workspaceId       String

  // Export format
  format            ExportFormat          // "jsonl", "parquet", "huggingface"

  // File metadata
  fileSize          BigInt?
  fileUrl           String?
  checksum          String?               // SHA-256 for integrity

  // Status
  status            ExportStatus          @default(PENDING)
  progress          Float                 @default(0)

  // Relations
  dataset           Dataset               @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())
  completedAt       DateTime?

  @@index([datasetId])
  @@index([status])
}

enum ExportFormat {
  JSONL
  PARQUET
  HUGGINGFACE
  CSV
  JSON
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Privacy and consent tracking
model PrivacyConsent {
  id                String                @id @default(cuid())
  workspaceId       String
  userId            String

  // Consent types
  collectFeedback   Boolean               @default(false)
  useForTraining    Boolean               @default(false)
  shareWithPartners Boolean               @default(false)
  allowEvaluation   Boolean               @default(false)

  // Document tracking
  consentDocumentVersion String?
  consentGivenAt    DateTime?
  consentRevokedAt  DateTime?

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([collectFeedback])
  @@index([useForTraining])
}

// Training participation consent
model TrainingConsent {
  id                String                @id @default(cuid())
  workspaceId       String
  userId            String
  conversationId    String

  // Specific conversation consent
  allowUseInTraining Boolean              @default(false)
  allowUseInEvaluation Boolean            @default(false)

  // Opt-out reasons
  optOutReason      String?

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation      Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([conversationId, userId])
  @@index([workspaceId])
  @@index([allowUseInTraining])
}

// Feedback analytics aggregate
model FeedbackAnalytics {
  id                String                @id @default(cuid())
  workspaceId       String

  // Time period
  periodStart       DateTime
  periodEnd         DateTime

  // Aggregates
  totalFeedback     Int                   @default(0)
  averageRating     Float                 @default(0)
  helpfulCount      Int                   @default(0)
  unhelpfulCount    Int                   @default(0)

  // By type
  feedbackByType    Json?                 // {rating: 100, correction: 50}

  // Quality metrics
  averageQualityScore Float               @default(0)
  averageSatisfaction Float               @default(0)

  // Issues
  topIssues         Json?                 // [{issue: "hallucination", count: 20}]

  // Relations
  workspace         Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([workspaceId, periodStart, periodEnd])
  @@index([workspaceId])
  @@index([periodStart])
}

