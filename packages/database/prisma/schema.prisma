// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User & Authentication Models
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  name          String?
  image         String?
  password      String?
  role          UserRole    @default(USER)
  status        UserStatus  @default(ACTIVE)

  // OAuth accounts
  accounts      Account[]

  // User data
  profile       UserProfile?
  preferences   UserPreferences?

  // Workspace membership
  workspaces    WorkspaceMember[]

  // Content & projects
  projects      Project[]
  documents     Document[]
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  audios        GeneratedAudio[]

  // Activity tracking
  activityLogs  ActivityLog[]

  // Auth sessions (refresh tokens)
  refreshTokens RefreshToken[]

  // Outstanding password-reset tokens
  passwordResetTokens PasswordResetToken[]

  // Outstanding email-verification tokens
  emailVerificationTokens EmailVerificationToken[]

  // In-app notifications
  notifications Notification[]

  // Workspace invitations sent by this user
  sentInvitations WorkspaceInvitation[]

  // Folders created and assets uploaded by this user
  createdFolders  Folder[]
  uploadedAssets  Asset[]

  // Conversation folders created by this user
  conversationFolders ConversationFolder[]

  // Memory system
  memories      Memory[]
  memoryAuditLogs MemoryAuditLog[]
  memoryExports MemoryExport[]

  // Tool calling engine
  createdTools      ToolDefinition[]
  toolExecutions    ToolExecution[] @relation("UserToolExecutions")
  toolAuditLogs     ToolAuditLog[]
  createdToolSecrets ToolSecret[]
  toolSecretAuditLogs ToolSecretAuditLog[]

  // Universal Search System
  searchQueries     SearchQuery[]
  savedSearches     SavedSearch[]

  // Timestamps
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastLoginAt   DateTime?

  // Login lockout: incremented on each failed password verification, reset
  // to 0 on a successful login. lockedUntil is set once the threshold is
  // reached and cleared on the next successful login.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  @@index([status])
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserProfile {
  id            String    @id @default(cuid())
  userId        String    @unique
  bio           String?
  avatar        String?
  banner        String?
  website       String?
  location      String?
  socialLinks   Json?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

model UserPreferences {
  id                String    @id @default(cuid())
  userId            String    @unique
  theme             Theme     @default(LIGHT)
  language          String    @default("en")
  emailNotifications Boolean   @default(true)
  pushNotifications Boolean   @default(false)
  marketingEmails   Boolean   @default(false)

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

enum Theme {
  LIGHT
  DARK
  AUTO
}

// Workspace Models
model Workspace {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String?
  avatar        String?

  members       WorkspaceMember[]
  projects      Project[]
  apiKeys       ApiKey[]
  invitations   WorkspaceInvitation[]
  folders       Folder[]
  assets        Asset[]
  auditLogs     AuditLog[]

  // Billing relations (M6)
  subscription  Subscription?
  invoices      Invoice[]
  paymentMethods PaymentMethod[]
  credits       WorkspaceCredits?
  creditLedger  CreditLedgerEntry[]
  usageRecords  UsageRecord[]

  // Release 3: Chat relations
  conversations       Conversation[]
  conversationFolders ConversationFolder[]
  conversationTags    ConversationTag[]
  aiMemory            AIMemory?
  promptTemplates     PromptTemplate[]
  conversationTemplates ConversationTemplate[]
  tools               Tool[]

  // Release 3: Universal Memory System
  memories            Memory[]
  memoryQuota         MemoryQuota?
  memoryExports       MemoryExport[]

  // Release 3: Universal Tool Calling Engine
  toolDefinitions     ToolDefinition[]
  toolExecutions      ToolExecution[]
  toolQuota           ToolQuota?
  toolSecrets         ToolSecret[]
  toolSecretAuditLogs ToolSecretAuditLog[]

  // Release 3: Universal Search System
  searchIndices       SearchIndex[]
  searchQueries       SearchQuery[]
  savedSearches       SavedSearch[]
  searchSuggestions   SearchSuggestion[]
  searchRankings      SearchRanking[]
  searchAnalytics     SearchAnalytics[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WorkspaceMember {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String
  role          WorkspaceRole @default(MEMBER)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
  VIEWER
}

model WorkspaceInvitation {
  id            String    @id @default(cuid())
  workspaceId   String
  email         String
  role          WorkspaceRole @default(MEMBER)
  token         String    @unique
  invitedById   String
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy     User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@index([token])
}

model ApiKey {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  key           String    @unique
  lastUsedAt    DateTime?
  expiresAt     DateTime?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
}

// Project Models
model Project {
  id            String    @id @default(cuid())
  userId        String
  workspaceId   String?
  name          String
  description   String?
  status        ProjectStatus @default(ACTIVE)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  documents     Document[]
  images        GeneratedImage[]
  videos        GeneratedVideo[]
  audios        GeneratedAudio[]
  folders       Folder[]
  assets        Asset[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([workspaceId])
}

// A folder organizes assets within a workspace, optionally scoped to a
// single project and optionally nested under a parent folder. Deleting a
// folder cascades to its subfolders (recursive folder semantics) but only
// detaches (never deletes) the assets inside it — see Asset.folder below.
model Folder {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String?
  parentId      String?
  name          String
  createdById   String

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent        Folder?   @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children      Folder[]  @relation("FolderChildren")
  createdBy     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  assets        Asset[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([parentId])
}

// A generic uploaded file, distinct from the AI-generated content models
// above (GeneratedImage/Video/Audio) — an Asset is something a member
// uploaded, not something Synora produced. Stored via the same
// provider-agnostic storage abstraction used for avatars.
model Asset {
  id            String    @id @default(cuid())
  workspaceId   String
  projectId     String?
  folderId      String?
  name          String
  url           String
  key           String
  mimeType      String
  size          Int
  uploadedById  String

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder        Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy    User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([workspaceId])
  @@index([projectId])
  @@index([folderId])
}

// Per-workspace audit trail for permission-sensitive actions (member
// invited/removed/role-changed, project/folder/asset lifecycle, workspace
// settings changes). actorId is a soft reference — same reasoning as
// MFAAuditLog: the trail must remain queryable even if the actor's account
// is later removed.
model AuditLog {
  id            String    @id @default(cuid())
  workspaceId   String
  actorId       String
  action        String
  targetType    String
  targetId      String?
  metadata      Json?

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// Content Models
model Document {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  title         String
  content       String
  format        DocumentFormat @default(MARKDOWN)
  status        ContentStatus @default(DRAFT)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  publishedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

enum DocumentFormat {
  MARKDOWN
  HTML
  PLAIN_TEXT
  RICH_TEXT
}

model GeneratedImage {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  imageUrl      String
  thumbnailUrl  String?
  width         Int
  height        Int
  model         String
  status        ContentStatus @default(COMPLETED)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([projectId])
}

model GeneratedVideo {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  videoUrl      String
  thumbnailUrl  String?
  duration      Int
  width         Int
  height        Int
  model         String
  status        ContentStatus @default(PROCESSING)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

model GeneratedAudio {
  id            String    @id @default(cuid())
  userId        String
  projectId     String?
  prompt        String
  audioUrl      String
  duration      Int
  model         String
  status        ContentStatus @default(PROCESSING)

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@index([userId])
  @@index([projectId])
}

enum ContentStatus {
  DRAFT
  PROCESSING
  COMPLETED
  FAILED
  PUBLISHED
}

// Activity Tracking
model ActivityLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  resource      String
  resourceId    String
  metadata      Json?
  ipAddress     String?
  userAgent     String?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Session Management (for NextAuth)
model Session {
  id            String    @id @default(cuid())
  sessionToken  String    @unique
  userId        String
  expires       DateTime

  createdAt     DateTime  @default(now())

  @@index([userId])
}

model VerificationToken {
  identifier    String
  token         String    @unique
  expires       DateTime

  @@unique([identifier, token])
}

// Refresh tokens for stateful, revocable sessions. The raw opaque token is
// never stored — only its SHA-256 hash — so a database read cannot mint a
// session. Rotation is enforced by revoking the presented token whenever a
// new one is issued; logout revokes the token, which is what makes "log out"
// actually end the session (the short-lived access token expires within
// minutes, and no new one can be minted without a live refresh token).
//
// userAgent/ipAddress/lastUsedAt are device-session metadata captured at
// issue time (and refreshed on rotation) so a signed-in user can see and
// individually revoke their active sessions ("this device", "logout
// everywhere"). rememberMe records which expiry policy produced this
// token's expiresAt, purely for display — it never changes verification.
model RefreshToken {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  userAgent   String?
  ipAddress   String?
  rememberMe  Boolean   @default(false)

  @@index([userId])
  @@index([expiresAt])
}

// Password-reset tokens. Same hash-at-rest discipline as RefreshToken:
// the raw token only ever appears in the reset email/link. Single-use
// (usedAt) and short-lived (expiresAt); consuming one revokes every
// active refresh token for the user.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// Email-verification tokens. Same hash-at-rest discipline as
// PasswordResetToken: the raw token only ever appears in the verification
// email/link. Single-use (usedAt) and short-lived (expiresAt).
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// In-app notifications. Created at real event trigger points alongside the
// corresponding transactional email (password changed/reset, email
// verified, workspace created) — never fabricated for display purposes.
model Notification {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum NotificationType {
  SECURITY
  ACCOUNT
  WORKSPACE
  SYSTEM
  BILLING
}

// MFA Audit Logging
// userId is a soft reference (no FK): audit records must survive user
// lifecycle changes and remain queryable for compliance retention windows.
model MFAAuditLog {
  id            String    @id @default(cuid())
  userId        String
  action        String
  metadata      Json?
  timestamp     DateTime  @default(now())
  createdAt     DateTime  @default(now())

  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@index([timestamp])
}

// Billing Models
// Admin-editable plan catalog. Each plan defines pricing, credits, trial period,
// and feature set. One plan marked as default for new workspaces.
model Plan {
  id                String      @id @default(cuid())
  key               String      @unique
  name              String
  status            PlanStatus  @default(ACTIVE)
  interval          BillingInterval
  priceCents        Int
  creditsPerInterval Int         @default(0)
  trialDays         Int?
  features          Json?
  isDefault         Boolean     @default(false)
  sortOrder         Int         @default(0)
  providerPriceIds  Json?

  subscriptions     Subscription[]

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([isDefault])
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

// Exactly one subscription per workspace. Tracks the current plan,
// subscription status, billing periods, and external provider IDs.
model Subscription {
  id                      String              @id @default(cuid())
  workspaceId             String              @unique
  planId                  String
  provider                String?
  externalCustomerId      String?
  externalSubscriptionId  String?
  status                  SubscriptionStatus  @default(ACTIVE)
  currentPeriodStart      DateTime?
  currentPeriodEnd        DateTime?
  cancelAtPeriodEnd       Boolean             @default(false)
  trialEndsAt             DateTime?

  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan                    Plan                @relation(fields: [planId], references: [id])

  invoices                Invoice[]
  paymentMethods          PaymentMethod[]

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([workspaceId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIAL
}

// Invoice records synced from the payment provider via webhooks.
// Only reads come from local DB; external-sync happens via webhooks only.
model Invoice {
  id                String          @id @default(cuid())
  subscriptionId    String
  workspaceId       String
  provider          String
  externalInvoiceId String          @unique
  status            InvoiceStatus
  amountDueCents    Int
  amountPaidCents   Int
  currency          String          @default("USD")
  hostedInvoiceUrl  String?
  periodStart       DateTime?
  periodEnd         DateTime?
  issuedAt          DateTime?
  paidAt            DateTime?

  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
  @@index([subscriptionId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

// Payment methods synced from provider via webhooks. Supports multiple
// payment methods per subscription; one marked as default.
model PaymentMethod {
  id                      String              @id @default(cuid())
  subscriptionId          String
  workspaceId             String
  provider                String
  externalPaymentMethodId String              @unique
  type                    PaymentMethodType
  brand                   String?
  last4                   String?
  expiryMonth             Int?
  expiryYear              Int?
  isDefault               Boolean             @default(false)

  subscription            Subscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  workspace               Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([workspaceId])
  @@index([subscriptionId])
}

enum PaymentMethodType {
  CARD
  BANK_ACCOUNT
  OTHER
}

// Credit balance per workspace. Denormalized for fast reads;
// source of truth for available balance.
model WorkspaceCredits {
  id            String          @id @default(cuid())
  workspaceId   String          @unique
  balance       Int             @default(0)
  updatedAt     DateTime        @updatedAt

  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// Append-only credit transaction log. Every grant, deduction, adjustment,
// expiration, or refund creates one entry. Never updated after creation.
model CreditLedgerEntry {
  id            String                  @id @default(cuid())
  workspaceId   String
  type          CreditTransactionType
  amount        Int
  balanceAfter  Int
  reason        String
  actorId       String?
  metadata      Json?
  createdAt     DateTime                @default(now())

  workspace     Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

enum CreditTransactionType {
  GRANT
  DEDUCTION
  ADJUSTMENT
  EXPIRATION
  REFUND
}

// Usage records for audit and future analytics. Records when capabilities
// are invoked and how many credits they consume. Callable today (M6),
// first call sites added in M7.
model UsageRecord {
  id            String    @id @default(cuid())
  workspaceId   String
  userId        String?
  capability    String
  quantity      Int       @default(1)
  creditsCost   Int
  metadata      Json?
  createdAt     DateTime  @default(now())

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([capability, createdAt])
}

// Webhook event deduplication table. Prevents duplicate processing of
// the same webhook event replayed by the provider.
model ProcessedWebhookEvent {
  id            String    @id @default(cuid())
  provider      String
  externalEventId String

  createdAt     DateTime  @default(now())

  @@unique([provider, externalEventId])
  @@index([provider, createdAt])
}

// Release 3: Universal AI Workspace - Chat Models

model Conversation {
  id                String    @id @default(cuid())
  workspaceId       String
  title             String
  description       String?
  provider          String
  model             String
  status            ConversationStatus @default(ACTIVE)
  isArchived        Boolean   @default(false)
  isPinned          Boolean   @default(false)
  // Denormalized from the latest Message.createdAt in this conversation,
  // maintained by conversationGeneration.service.ts (M2) — avoids a
  // correlated subquery/join for the default "most recently active first"
  // list sort. Null until the first message is sent.
  lastMessageAt     DateTime?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  messages          Message[]
  folder            ConversationFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  folderId          String?
  tags              ConversationTag[]
  collaborators     ConversationCollaborator[]
  versions          ConversationVersion[]
  activity          ConversationActivity[]
  shared            SharedConversation[]
  usage             ConversationUsage?
  toolCalls         ToolCall[]
  toolExecutions    ToolExecution[]
  memories          Memory[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, lastMessageAt])
  @@index([isArchived])
  @@index([isPinned])
}

enum ConversationStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

// deletedAt follows the same nullable-timestamp soft-delete convention as
// RefreshToken.revokedAt/WorkspaceInvitation.revokedAt (presence = deleted,
// value = when) rather than introducing a new isDeleted-boolean pattern.
// Added in M1 specifically so M3 (message lifecycle) can implement soft
// delete without a further migration: the architecture calls for deleting a
// message to orphan, not cascade-remove, its children, which soft-delete
// naturally gives for free (a plain UPDATE never triggers the parentId FK's
// cascade — that only fires on an actual SQL DELETE, which soft-delete
// never issues).
model Message {
  id                String    @id @default(cuid())
  conversationId    String
  content           String
  role              MessageRole
  parentId          String?
  deletedAt         DateTime?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent            Message?  @relation("MessageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          Message[] @relation("MessageTree")

  branch            MessageBranch?
  attachments       MessageAttachment[]
  streamingJob      StreamingJob?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, deletedAt])
  @@index([parentId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model MessageBranch {
  id                String    @id @default(cuid())
  messageId         String    @unique
  branchIndex       Int
  isMainBranch      Boolean   @default(false)

  message           Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([messageId])
}

model MessageAttachment {
  id                String    @id @default(cuid())
  messageId         String
  url               String
  mimeType          String
  name              String
  size              Int

  message           Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([messageId])
}

model ConversationFolder {
  id                String    @id @default(cuid())
  workspaceId       String
  parentId          String?
  name              String
  createdById       String

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent            ConversationFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children          ConversationFolder[] @relation("FolderTree")
  createdBy         User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([parentId])
  @@index([createdById])
}

model ConversationTag {
  id                String    @id @default(cuid())
  workspaceId       String
  name              String
  color             String?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations     Conversation[]

  createdAt         DateTime  @default(now())

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PromptTemplate {
  id                String    @id @default(cuid())
  workspaceId       String?
  name              String
  content           String
  category          String?
  tags              String[]
  isPublic          Boolean   @default(false)
  usageCount        Int       @default(0)
  isFavorite        Boolean   @default(false)

  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([isPublic])
}

model ConversationTemplate {
  id                String    @id @default(cuid())
  workspaceId       String?
  name              String
  description       String?
  initialMessages   Json
  category          String?
  isPublic          Boolean   @default(false)
  usageCount        Int       @default(0)

  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([isPublic])
}

model AIMemory {
  id                String    @id @default(cuid())
  workspaceId       String    @unique
  context           Json

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model SharedConversation {
  id                String    @id @default(cuid())
  conversationId    String
  shareToken        String    @unique
  expiresAt         DateTime?
  isPublic          Boolean   @default(false)
  permissions       SharePermission @default(VIEW)

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([conversationId])
  @@index([shareToken])
}

enum SharePermission {
  VIEW
  COMMENT
  EDIT
}

model ConversationCollaborator {
  id                String    @id @default(cuid())
  conversationId    String
  userId            String
  role              CollaboratorRole

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([conversationId, userId])
  @@index([conversationId])
}

enum CollaboratorRole {
  VIEWER
  EDITOR
  OWNER
}

model ConversationActivity {
  id                String    @id @default(cuid())
  conversationId    String
  action            String
  metadata          Json?

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([conversationId, createdAt])
}

model ConversationVersion {
  id                String    @id @default(cuid())
  conversationId    String
  content           Json

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([conversationId, createdAt])
}

// messageId/attempt/lastError added in M2 (Universal Conversation Engine)
// so retry support and error recovery are inspectable, not opaque:
// messageId links to the assistant Message this job produced (set only on
// success — see conversationGeneration.service.ts for why a Message row is
// never created until generation actually succeeds), attempt counts calls
// made so far, lastError holds the most recent failure's message.
model StreamingJob {
  id                String    @id @default(cuid())
  conversationId    String
  messageId         String?   @unique
  message           Message?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  status            StreamingJobStatus @default(PENDING)
  attempt           Int       @default(0)
  lastError         String?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  completedAt       DateTime?

  @@index([conversationId])
  @@index([status])
  @@index([conversationId, status])
}

enum StreamingJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELED
}

model Tool {
  id                String    @id @default(cuid())
  workspaceId       String?
  name              String
  description       String?
  definition        Json
  isPublic          Boolean   @default(false)

  workspace         Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calls             ToolCall[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([workspaceId])
  @@index([isPublic])
}

// executedBy is a soft reference — same reasoning as AuditLog.actorId: a
// tool-execution audit trail must remain queryable even if the executing
// account is later removed. conversationId is a hard reference (cascade),
// matching ConversationActivity, since every call happens within a
// conversation's agent loop.
model ToolCall {
  id                String    @id @default(cuid())
  toolId            String
  conversationId    String
  executedBy        String
  input             Json
  output            Json?
  error             String?

  tool              Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([toolId])
  @@index([conversationId])
}

model ConversationUsage {
  id                String    @id @default(cuid())
  conversationId    String    @unique
  inputTokens       Int       @default(0)
  outputTokens      Int       @default(0)
  totalTokens       Int       @default(0)
  estimatedCost     Float     @default(0)

  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Universal Memory System (Release 3)
// Provider-independent long-term memory engine for conversations
// Supports billions of memory records across workspaces

model Memory {
  id                String          @id @default(cuid())
  workspaceId       String
  conversationId    String?
  userId            String

  // Content
  content           String
  summary           String?
  type              MemoryType
  category          String?
  tags              String[]        @default([])

  // Metadata
  importance        Float           @default(0.5)    // 0-1 score
  decayRate         Float           @default(0.01)   // Daily decay percentage
  lastAccessedAt    DateTime?
  accessCount       Int             @default(0)

  // Status
  isArchived        Boolean         @default(false)
  isPinned          Boolean         @default(false)
  isManual          Boolean         @default(true)   // vs auto-generated
  status            MemoryStatus    @default(ACTIVE)

  // Permissions
  permission        MemoryPermission @default(PRIVATE)
  sharedWith        String[]        @default([])     // userIds

  // Versioning & history
  version           Int             @default(1)
  parentId          String?         // Previous version
  parent            Memory?         @relation("MemoryVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions          Memory[]        @relation("MemoryVersions")

  // Relations
  relatedMemories   MemoryRelation[] @relation("MemoryFrom")
  relatedBy         MemoryRelation[] @relation("MemoryTo")

  // Embedding metadata (for vector DB)
  embeddingId       String?         // Vector DB record ID (Pinecone, Weaviate, etc.)
  embeddingModel    String?         // e.g., "text-embedding-3-small"
  embeddingVersion  Int             @default(0)
  embeddingRefreshNeeded Boolean    @default(false)

  // Encryption
  isEncrypted       Boolean         @default(false)
  encryptionKey     String?         @db.Text // Encrypted key reference

  // Lifecycle
  expiresAt         DateTime?

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  metadata          MemoryMetadata?
  auditLogs         MemoryAuditLog[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
  @@index([conversationId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([isPinned])
  @@index([importance])
  @@index([createdAt])
  @@index([workspaceId, conversationId, type])
  @@index([workspaceId, userId, status])
}

model MemoryMetadata {
  id                String    @id @default(cuid())
  memoryId          String    @unique

  // Memory type specific metadata
  source            String?   // Where memory came from (e.g., "conversation", "tool", "manual")
  context           Json?     // Context at time of creation
  confidence        Float     @default(1.0)  // How confident we are in this memory

  // Consolidation state
  isConsolidated    Boolean   @default(false)
  consolidatedAt    DateTime?
  consolidationScore Float?   // How well consolidated (0-1)

  // Metrics
  relevanceScore    Float     @default(1.0)
  retrievalCount    Int       @default(0)
  lastRetrievedAt   DateTime?

  // Analytics
  tokens            Int       @default(0)
  size              Int       @default(0)  // bytes

  memory            Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MemoryRelation {
  id                String    @id @default(cuid())
  fromId            String
  toId              String
  relationType      String    // "related_to", "references", "contradicts", "expands", etc.
  strength          Float     @default(1.0)  // 0-1 relation strength

  from              Memory    @relation("MemoryFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to                Memory    @relation("MemoryTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([fromId, toId, relationType])
  @@index([fromId])
  @@index([toId])
}

model MemoryAuditLog {
  id                String    @id @default(cuid())
  memoryId          String
  userId            String

  action            String    // "created", "updated", "accessed", "consolidated", "archived", "deleted", etc.
  changes           Json?     // What changed
  reason            String?
  metadata          Json?

  memory            Memory    @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([memoryId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model MemoryQuota {
  id                String    @id @default(cuid())
  workspaceId       String    @unique

  // Quotas (adjustable per plan)
  maxMemories       Int       @default(10000)
  maxTokens         Int       @default(1000000)
  maxStorage        BigInt    @default(1000000000)  // 1GB

  // Current usage
  currentMemories   Int       @default(0)
  currentTokens     Int       @default(0)
  currentStorage    BigInt    @default(0)

  // Limits
  maxConsolidationsPerDay Int @default(100)
  consolidationsUsedToday Int @default(0)
  lastResetAt       DateTime  @default(now())

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MemoryCache {
  id                String    @id @default(cuid())
  memoryId          String    @unique

  // Cache metadata
  cachedAt          DateTime  @default(now())
  expiresAt         DateTime
  hits              Int       @default(0)
  lastHitAt         DateTime?

  // Serialized content (Redis backup)
  serialized        String    @db.Text
}

enum MemoryType {
  // Duration-based
  SHORT_TERM        // Temporary, active context (minutes to hours)
  LONG_TERM         // Persistent knowledge (weeks to indefinite)

  // Knowledge-based
  SEMANTIC          // Facts, concepts, relationships
  EPISODIC          // Events, experiences, conversations

  // Scope-based
  WORKSPACE         // Workspace-level knowledge
  CONVERSATION      // Conversation-specific context

  // Management-based
  PINNED            // User explicitly pinned
  MANUAL            // User manually created
  AUTOMATIC         // System auto-generated from conversations/tools
}

enum MemoryStatus {
  ACTIVE            // Normal, retrievable
  ARCHIVED          // Hidden but preserved
  DELETED           // Soft-deleted, awaiting expiry
  EXPIRED           // TTL expired
  CONSOLIDATING     // Being consolidated/summarized
  DECAYING          // Importance below threshold
}

enum MemoryPermission {
  PRIVATE           // Only user can access
  WORKSPACE         // All workspace members can access
  SHARED            // Specific users can access
  PUBLIC            // All authenticated users can access
}

// Future workspace expansion
model MemoryExport {
  id                String    @id @default(cuid())
  workspaceId       String
  userId            String

  format            String    // "json", "markdown", "csv", etc.
  filteredBy        String?   // JSON query used to filter memories

  storageKey        String    // S3 or object storage path
  size              Int

  status            String    @default("pending")
  completedAt       DateTime?

  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime  @default(now())

  @@index([workspaceId])
  @@index([userId])
}

// Release 3: Universal Tool Calling Engine
// Production-grade tool execution platform with streaming, retry, circuit breaker, sandboxing

model ToolDefinition {
  id                String          @id @default(cuid())
  workspaceId       String?         // NULL for global tools
  name              String
  displayName       String
  description       String          @db.Text
  category          String          // e.g., "http", "database", "file", "python", "search"
  type              ToolType        // HTTP, GraphQL, Database, Search, File, Browser, Python, Webhook, MCP

  // Schema & Validation
  inputSchema       Json            // JSON Schema for input validation
  outputSchema      Json?           // JSON Schema for output validation

  // Configuration
  config            Json            // Provider-specific configuration
  secrets           String[]        @default([])  // Secret keys used by this tool

  // Capabilities & Permissions
  capabilities      String[]        @default([])  // e.g., ["read", "write", "execute"]
  permission        ToolPermission  @default(PRIVATE)
  allowedRoles      String[]        @default([])  // Empty = all roles allowed

  // Limits & Quotas
  maxParallelCalls  Int             @default(10)
  rateLimit         Int?            // Calls per minute, NULL = unlimited
  timeout           Int             @default(30000)  // ms
  maxRetries        Int             @default(3)

  // Flags
  isActive          Boolean         @default(true)
  isAsync           Boolean         @default(false)
  supportsStreaming Boolean         @default(false)
  requiresApproval  Boolean         @default(false)  // Human approval before execution

  // Versioning & History
  version           Int             @default(1)
  parentId          String?         // Previous version
  parent            ToolDefinition? @relation("ToolVersions", fields: [parentId], references: [id], onDelete: SetNull)
  versions          ToolDefinition[] @relation("ToolVersions")

  // Relations
  workspace         Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions        ToolExecution[]
  auditLogs         ToolAuditLog[]
  dependencies      ToolDependency[] @relation("ToolFrom")
  dependents        ToolDependency[] @relation("ToolTo")
  metrics           ToolMetrics?
  webhooks          ToolWebhook[]
  toolSecrets       ToolSecret[]

  createdBy         String
  createdByUser     User            @relation(fields: [createdBy], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([category])
  @@index([type])
  @@index([isActive])
  @@index([createdBy])
}

enum ToolType {
  HTTP
  GraphQL
  Database
  Search
  File
  Browser
  Python
  Webhook
  MCP
  Custom
}

enum ToolPermission {
  PRIVATE         // Only tool owner
  WORKSPACE       // All workspace members
  SHARED          // Specific users
  PUBLIC          // All authenticated users
}

// Tool dependencies (e.g., Tool A depends on output of Tool B)
model ToolDependency {
  id                String          @id @default(cuid())
  fromId            String          // Tool that depends on output
  toId              String          // Tool that must run first

  // Dependency configuration
  passOutputAs      String?         // Parameter name to pass output to
  transformOutput   String?         // Optional JSON path/transform
  isOptional        Boolean         @default(false)

  from              ToolDefinition  @relation(name: "ToolFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to                ToolDefinition  @relation(name: "ToolTo", fields: [toId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@unique([fromId, toId])
  @@index([fromId])
  @@index([toId])
}

// Tool execution (call to a tool)
model ToolExecution {
  id                String          @id @default(cuid())
  toolId            String
  workspaceId       String
  conversationId    String?         // If called from conversation
  userId            String

  // Execution details
  input             Json
  output            Json?
  error             String?

  // Status & Progress
  status            ExecutionStatus @default(PENDING)
  progress          Float           @default(0)  // 0-100

  // Streaming (for long-running operations)
  isStreaming       Boolean         @default(false)
  streamStartedAt   DateTime?

  // Retry tracking
  attemptNumber     Int             @default(1)
  maxAttempts       Int             @default(3)
  lastError         String?

  // Circuit breaker state
  circuitBreakerOpen Boolean        @default(false)

  // Timing
  startedAt         DateTime?
  completedAt       DateTime?
  duration          Int?            // milliseconds

  // Cost tracking
  inputTokens       Int             @default(0)
  outputTokens      Int             @default(0)
  costCents         Int             @default(0)

  // Approval workflow
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectionReason   String?

  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation      Conversation?   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user              User            @relation("UserToolExecutions", fields: [userId], references: [id], onDelete: Cascade)

  invocations       ToolInvocation[]
  auditLogs         ToolAuditLog[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([toolId])
  @@index([workspaceId])
  @@index([userId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
}

enum ExecutionStatus {
  PENDING           // Waiting to execute
  APPROVED          // Approved, waiting to run
  RUNNING           // Currently executing
  STREAMING         // Streaming response
  COMPLETED         // Successfully completed
  FAILED            // Failed with error
  CANCELLED         // User cancelled
  TIMEOUT           // Execution timeout
  REJECTED          // Approval rejected
}

// Individual tool invocation (atomic operation within execution)
model ToolInvocation {
  id                String          @id @default(cuid())
  executionId       String
  parentInvocationId String?        // For nested calls

  // Call details
  input             Json
  output            Json?
  error             String?

  // Status
  status            ExecutionStatus @default(PENDING)

  // Timing
  startedAt         DateTime?
  completedAt       DateTime?

  // Order (for parallel/sequential tracking)
  sequenceNumber    Int
  retryCount        Int             @default(0)

  execution         ToolExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  parent            ToolInvocation? @relation(name: "ToolInvocationTree", fields: [parentInvocationId], references: [id], onDelete: Cascade)
  children          ToolInvocation[] @relation(name: "ToolInvocationTree")

  createdAt         DateTime        @default(now())

  @@index([executionId])
  @@index([parentInvocationId])
}

// Tool execution audit log (immutable trail)
model ToolAuditLog {
  id                String          @id @default(cuid())
  toolId            String
  executionId       String?
  userId            String

  action            String          // "CREATED", "EXECUTED", "FAILED", "APPROVED", "REJECTED"
  status            String?

  changes           Json?           // For definition changes
  metadata          Json?           // Additional context

  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  execution         ToolExecution?  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@index([toolId])
  @@index([executionId])
  @@index([userId])
  @@index([action])
}

// Tool metrics (aggregated statistics)
model ToolMetrics {
  id                String          @id @default(cuid())
  toolId            String          @unique

  totalExecutions   Int             @default(0)
  successfulExecutions Int          @default(0)
  failedExecutions  Int             @default(0)

  avgDuration       Float           @default(0)
  minDuration       Int?
  maxDuration       Int?

  avgInputTokens    Float           @default(0)
  avgOutputTokens   Float           @default(0)
  totalCostCents    Int             @default(0)

  lastExecutedAt    DateTime?

  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([toolId])
}

// Webhook configuration for tool callbacks
model ToolWebhook {
  id                String          @id @default(cuid())
  toolId            String

  event             String          // "on-start", "on-progress", "on-complete", "on-error"
  url               String

  method            String          @default("POST")
  headers           Json?

  isActive          Boolean         @default(true)

  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@index([toolId])
  @@index([event])
}

// Tool workspace quota (limits per workspace)
model ToolQuota {
  id                String          @id @default(cuid())
  workspaceId       String          @unique

  // Usage limits
  maxToolsPerWorkspace Int          @default(100)
  maxExecutionsPerDay Int           @default(10000)
  maxCostPerMonth   Int             @default(100000)  // cents

  // Current usage (daily reset)
  executionsUsedToday Int           @default(0)
  costUsedThisMonth Int             @default(0)

  lastResetAt       DateTime        @default(now())

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
}

// Encrypted Tool Secrets (Release 3)
// Stores API keys, credentials, and other secrets for tool execution
model ToolSecret {
  id                String          @id @default(cuid())
  toolId            String
  workspaceId       String

  // Secret metadata
  name              String          // e.g., "api_key", "auth_token", "database_url"
  description       String?
  secretType        String          // API_KEY, PASSWORD, URL, TOKEN, CONNECTION_STRING, etc.

  // Encrypted value (AES-256-GCM)
  encryptedValue    String          @db.Text  // Base64-encoded ciphertext
  iv                String                    // Base64-encoded initialization vector
  authTag           String                    // Base64-encoded authentication tag
  algorithm         String          @default("aes-256-gcm")

  // Metadata
  expiresAt         DateTime?       // Optional expiration date
  isRotationPending Boolean         @default(false)
  lastRotatedAt     DateTime?

  // Relations
  tool              ToolDefinition  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  auditLogs         ToolSecretAuditLog[]

  createdBy         String
  createdByUser     User            @relation(fields: [createdBy], references: [id])

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([toolId, name])
  @@index([toolId])
  @@index([workspaceId])
  @@index([createdBy])
  @@index([expiresAt])
}

// Tool Secret Audit Log
// Immutable audit trail for all secret access and modifications
model ToolSecretAuditLog {
  id                String          @id @default(cuid())
  secretId          String
  workspaceId       String

  // Action tracking
  action            String          // CREATED, RETRIEVED, UPDATED, ROTATED, DELETED, ACCESSED
  reason            String?         // Why was the secret accessed (for audit)

  // Access context
  accessedBy        String
  accessedByUser    User            @relation(fields: [accessedBy], references: [id])

  // Security context
  ipAddress         String?
  userAgent         String?
  requestId         String?         // Correlation ID from request middleware

  // Relations
  secret            ToolSecret      @relation(fields: [secretId], references: [id], onDelete: Cascade)
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@index([secretId])
  @@index([workspaceId])
  @@index([accessedBy])
  @@index([action])
  @@index([createdAt])
}

// Universal Search System (Release 3)
// Comprehensive multi-provider search with hybrid, full-text, and vector capabilities

model SearchIndex {
  id                String          @id @default(cuid())
  workspaceId       String
  resourceType      SearchResourceType  // CONVERSATION, MESSAGE, MEMORY, DOCUMENT
  resourceId        String

  // Content for indexing
  title             String?
  content           String          @db.Text
  summary           String?
  keywords          String[]        @default([])

  // Chunking for large documents
  chunkIndex        Int             @default(0)  // Which chunk this is
  totalChunks       Int             @default(1)  // Total chunks for this resource

  // Vector embedding metadata
  embeddingId       String?         // Vector DB ID (Pinecone, Weaviate, etc.)
  embeddingModel    String?         // e.g., "text-embedding-3-small"
  embeddingDimension Int?

  // Full-text search metadata
  tsvector          String?         @db.Text  // PostgreSQL tsvector for FTS

  // Workspace and resource isolation
  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Metadata
  language          String          @default("en")
  isIndexed         Boolean         @default(false)
  indexedAt         DateTime?
  lastUpdatedAt     DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([workspaceId])
  @@index([resourceType])
  @@index([resourceId])
  @@index([workspaceId, resourceType, resourceId])
  @@index([isIndexed])
  @@index([indexedAt])
}

enum SearchResourceType {
  CONVERSATION
  MESSAGE
  MEMORY
  DOCUMENT
  PROMPT_TEMPLATE
  CONVERSATION_TEMPLATE
}

model SearchQuery {
  id                String          @id @default(cuid())
  workspaceId       String
  userId            String

  query             String
  queryType         SearchQueryType // HYBRID, FULLTEXT, VECTOR, SEMANTIC

  // Results metadata
  resultCount       Int             @default(0)
  executionTimeMs   Int             @default(0)

  // Analytics
  clickedResultId   String?         // Which result was clicked (if any)
  clickPosition     Int?            // Position in results
  isRelevant        Boolean?        // User feedback: was this relevant?

  // Rankings/ordering
  sortBy            String          @default("relevance")  // relevance, recent, popular

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@index([queryType])
}

enum SearchQueryType {
  HYBRID
  FULLTEXT
  VECTOR
  SEMANTIC
}

model SavedSearch {
  id                String          @id @default(cuid())
  workspaceId       String
  userId            String

  name              String
  description       String?
  query             String
  queryType         SearchQueryType @default(HYBRID)

  // Filters
  filters           Json?           // Saved filter configuration
  sortBy            String          @default("relevance")
  limit             Int             @default(20)

  // Pinning/favorites
  isPinned          Boolean         @default(false)
  pinnedOrder       Int?

  // Usage tracking
  executionCount    Int             @default(0)
  lastExecutedAt    DateTime?

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, userId, name])
  @@index([workspaceId])
  @@index([userId])
  @@index([isPinned])
}

model SearchSuggestion {
  id                String          @id @default(cuid())
  workspaceId       String

  term              String
  frequency         Int             @default(1)

  // Category
  type              SearchSuggestionType

  // Ranking
  popularity        Float           @default(0)  // 0-1 score

  // Cache management
  isActive          Boolean         @default(true)
  expiresAt         DateTime?

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, term])
  @@index([workspaceId])
  @@index([frequency])
  @@index([popularity])
}

enum SearchSuggestionType {
  QUERY       // Full query suggestions
  KEYWORD     // Single keyword suggestions
  FILTER      // Filter suggestions
  OPERATOR    // Search operator suggestions
}

model SearchRanking {
  id                String          @id @default(cuid())
  workspaceId       String
  resourceType      SearchResourceType

  // Ranking weights
  titleWeight       Float           @default(1.5)
  contentWeight     Float           @default(1.0)
  keywordWeight     Float           @default(1.2)
  recencyWeight     Float           @default(0.8)
  popularityWeight  Float           @default(0.6)
  importanceWeight  Float           @default(1.1)

  // Boosting
  boostRecent       Boolean         @default(true)  // Boost recently modified
  recentDaysThreshold Int           @default(7)
  recentBoost       Float           @default(1.3)

  // Personalization
  boostByUserInteraction Boolean    @default(true)

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, resourceType])
  @@index([workspaceId])
}

model SearchAnalytics {
  id                String          @id @default(cuid())
  workspaceId       String

  // Query metrics
  totalSearches     Int             @default(0)
  uniqueSearchers   Int             @default(0)
  avgExecutionTime  Float           @default(0)

  // Result metrics
  avgResultCount    Float           @default(0)
  clickThroughRate  Float           @default(0)

  // Most common queries
  topQueries        Json            // [{term: string, count: int}]
  topSearchers      Json            // [{userId: string, count: int}]

  // Performance metrics
  indexSize         BigInt          @default(0)
  cachedResultsHit  Int             @default(0)
  cachedResultsMiss Int             @default(0)

  // Time period
  periodStart       DateTime
  periodEnd         DateTime

  workspace         Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([workspaceId, periodStart, periodEnd])
  @@index([workspaceId])
}
