{
  "name": "@synora/observability",
  "version": "0.1.0",
  "private": true,
  "description": "Structured logging, distributed tracing, and metrics ports + implementations for the platform.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@synora/core": "workspace:*",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
