{
  "$schema": "https://turbo.build/json-schema.json",
  "globalDependencies": ["**/.env.local", ".env.local"],
  "globalEnv": ["DATABASE_URL", "NODE_ENV", "CI", "LOG_LEVEL", "JWT_SECRET", "TOOL_SECRET_MASTER_KEY"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "dist/**", ".tsbuildinfo/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [".eslintcache"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "outputs": ["coverage/**"],
      "cache": true,
      "dependsOn": ["^build"]
    },
    "type-check": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "format": {
      "cache": true
    },
    "db:generate": {
      "cache": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:migrate:dev": {
      "cache": false
    },
    "db:reset": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
