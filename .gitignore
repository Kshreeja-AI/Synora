# Local secret material — never commit real secrets
infrastructure/docker/secrets/
*.secret
.secrets/

# Secret-bearing backups. A backup of a configured environment file, or a
# database dump, carries exactly the credentials the patterns above exist to
# keep out of the repository — the copy is no less sensitive than the
# original. Named explicitly rather than trusted to `.env.*`, because a
# rescued `.env.local.bak` does not match that pattern.
*.bak
*.backup
*~
.env.local.*
env-backup/
backups/
*.dump
*.sql.gz
*.tar.gz

# A nested extract of this very repository (no .git of its own) plus the
# archive it came from. Kept on disk deliberately -- deleting founder material
# is not this file's job -- but never committed: a copy of the repo inside the
# repo doubles every future diff and confuses Docker build context.
/Synora-SYNORA/
/Synora-SYNORA.zip

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Local storage provider's upload directory (avatars, etc. — dev/single-instance only)
apps/backend/uploads/
uploads/

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Turborepo cache
.turbo/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
# Templates carry placeholders only and MUST be committed — they are the
# canonical record of what a deployment needs. Real values never are.
!.env.example
!.env.production.example
# Local env files that do not match the .env / .env.* patterns above.
.app.env
.web.env

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/
.env.local

# Local Redis dump (created by a locally-run redis-server during dev/testing)
dump.rdb

# Dataset export output files written by datasetExport.service.ts during local testing
apps/backend/exports/

# Playwright test artifacts
apps/web/e2e/.results/
apps/web/test-results/
apps/web/playwright-report/
