{
  "name": "synora",
  "version": "0.1.0",
  "description": "Synora AI - Premium AI Platform for Creators",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "type-check": "turbo run type-check",
    "clean": "turbo clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:migrate:dev": "turbo run db:migrate:dev",
    "db:reset": "turbo run db:reset",
    "db:studio": "turbo run db:studio",
    "secrets:check": "node scripts/check-no-client-secrets.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "turbo": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "comment": "Targeted transitive security overrides. Each pins the MINIMUM patched version inside the SAME major, so no direct dependency changes API. Ranges are version-scoped (pkg@<x) so the override lapses automatically once a parent ships the fix itself.",
    "overrides": {
      "nanoid@<3.3.17": "^3.3.17",
      "postcss@<8.5.23": "^8.5.23",
      "sharp@<0.35.0": "^0.35.0",
      "esbuild@<0.28.1": "^0.28.1"
    }
  },
  "license": "BUSL-1.1",
  "dependencies": {
    "@elastic/elasticsearch": "^9.4.3",
    "@types/socket.io": "^3.0.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  }
}
