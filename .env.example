# Environment
NODE_ENV=development

# Database
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora

# Authentication
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# API
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Provider Abstraction Layer
# When true, every AI/video/audio provider is served by an in-memory mock —
# no network calls, no API keys required. This is how local development and
# CI run by default; see apps/backend/src/providers/ for the abstraction.
USE_MOCK_PROVIDERS=true

# AI Providers (only needed when USE_MOCK_PROVIDERS=false)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REPLICATE_API_KEY=
# RUNWAYML_API_KEY=
# SYNTHESIA_API_KEY=

# Third-party Services (Optional)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
