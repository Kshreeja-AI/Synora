# Environment
NODE_ENV=development
# APP_STAGE: development | testing | qa | staging | production
# See docs/operations/ENVIRONMENT_MANAGEMENT.md for the full stage/mode model.
APP_STAGE=development

# Logging — error | warn | info | debug (default: info)
# LOG_LEVEL=info

# Operating Modes (independent of APP_STAGE — any combination may apply)
# OFFLINE_MODE=false
# MOCK_MODE=false
# ENTERPRISE_MODE=false
# GOVERNMENT_MODE=false
# SELF_HOSTED_MODE=false

# Database
# The Prisma client pins connection_limit=10 and pool_timeout=20s by default
# (see packages/database/src/index.ts) so pool size is always bounded — with
# N horizontally-scaled app instances each opening their own pool, an
# unbounded default multiplies against Postgres max_connections (100 by
# default) and causes "too many clients already" outages. Override via
# DB_CONNECTION_LIMIT / DB_POOL_TIMEOUT below, or set connection_limit/
# pool_timeout directly on DATABASE_URL's query string (takes precedence).
# DB_CONNECTION_LIMIT=10
# DB_POOL_TIMEOUT=20
#
# For production with 1K+ concurrent users, front Postgres with PgBouncer:
# DATABASE_URL=postgresql://user:password@pgbouncer:6432/synora?schema=public&connection_limit=20
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora

# Authentication
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000
# Remember-me sessions use a longer refresh-token lifetime than a normal login.
# JWT_REFRESH_EXPIRY_REMEMBER_ME=30d
# PASSWORD_RESET_TOKEN_EXPIRY=1h
# EMAIL_VERIFICATION_TOKEN_EXPIRY=24h

# Mail — console transport (logs mail, default everywhere) until MAIL_TRANSPORT=smtp
# is explicitly set. See docs/architecture.md#mailer-abstraction.
# MAIL_TRANSPORT=console
# MAIL_FROM_ADDRESS=noreply@synora.ai
# MAIL_FROM_NAME=Synora
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# File storage — local filesystem (default, single-instance). An S3-compatible
# provider lands in Release 2 M6; selecting it will be config-only.
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIRECTORY=uploads
# STORAGE_PUBLIC_BASE_PATH=/uploads
# STORAGE_MAX_UPLOAD_BYTES=5242880
# STORAGE_MAX_ASSET_UPLOAD_BYTES=26214400

# Virus scanning for uploaded files. Default is 'none' — with no scanner,
# uploads are recorded as UNSCANNED (never marked clean). In production such
# files cannot be downloaded until a scanner is configured; other stages
# allow them unless VIRUS_SCAN_FORCE_BLOCK_UNSCANNED=true. Infected files are
# always blocked. Set provider to 'clamav' and point it at a reachable clamd
# daemon (no API key — clamd is a private network service) to enable real
# scanning. Verify it took effect via GET /api/capabilities.
# VIRUS_SCAN_PROVIDER=clamav
# VIRUS_SCAN_CLAMAV_HOST=clamav
# VIRUS_SCAN_CLAMAV_PORT=3310
# VIRUS_SCAN_CLAMAV_TIMEOUT_MS=30000
# VIRUS_SCAN_MAX_BYTES=26214400
# VIRUS_SCAN_FORCE_BLOCK_UNSCANNED=false

# API
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# AI Providers — Release 1 (text/code generation)
# Provider auto-selects: the first provider below with its API key set wins,
# in this priority order (Anthropic first). Set AI_PROVIDER to force a
# specific one. See docs/production/R1-e_AI_PROVIDER_ABSTRACTION.md.
# AI_PROVIDER=anthropic

# Anthropic Claude (default provider)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Google Gemini
# GOOGLE_AI_API_KEY=
# GEMINI_MODEL=gemini-1.5-pro

# xAI Grok
# XAI_API_KEY=
# XAI_MODEL=grok-2-latest

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# DeepSeek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Together AI
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# Azure OpenAI (all three required together)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# AWS Bedrock — all three required together. BEDROCK_REGION has no default:
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY alone are too common in AWS-hosted
# environments for unrelated reasons (ECS/EC2/CI credentials) to safely
# auto-activate Bedrock from their presence alone.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# BEDROCK_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Ollama (local/self-hosted — no API key, but base URL is required)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Groq (OpenAI-compatible; hosts open-weight models — Llama, Qwen, Gemma)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Any OpenAI-compatible endpoint — vLLM, TGI, llama.cpp server, a second
# Ollama, or a hosted router. BOTH url and model are required: a generic
# endpoint's model id cannot be guessed, and guessing produces a provider
# that looks ready and fails on first use.
# SELF_HOSTED_TEXT_BASE_URL=
# SELF_HOSTED_TEXT_API_KEY=
# SELF_HOSTED_TEXT_MODEL=
# Does this endpoint bill per token? Defaults to TRUE — fail closed on money.
# A wrong `false` silently disables the cost cap; a wrong `true` merely
# refuses a free runtime early, which is visible and recoverable.
# SELF_HOSTED_TEXT_METERED=true

# ============================================
# CAPABILITY → PROVIDER → MODEL
#
# Synora routes by CAPABILITY. Business logic never names a vendor, so
# switching provider or model is a variable below, never a code change.
#
# Which of the intended models each adapter can actually address:
#
#   gpt-oss-20b, Gemma, DeepSeek R1, Llama, Qwen  → OPENROUTER_MODEL,
#       TOGETHER_MODEL, GROQ_MODEL, OLLAMA_MODEL or SELF_HOSTED_TEXT_MODEL.
#       These adapters pass the model id straight through, so any model the
#       provider hosts is addressable. Use the provider's EXACT api model id,
#       not its marketing name.
#   Claude, Gemini                                → their own adapters above.
#   FLUX                                          → NO ADAPTER. The only image
#       adapter is OpenAI. A Replicate/FLUX image adapter does not exist.
#   Seedance, Wan                                 → REPLICATE_VIDEO_MODEL,
#       if Replicate hosts them under an id the video adapter can submit.
#   Fish Audio (S2.1 Pro / Transcribe 1)          → NO ADAPTER.
#   NVIDIA Nemotron (Embed VL / Content Safety)   → NO ADAPTER.
#
# A missing adapter is a code change, not a credential. Nothing below will
# make one appear.
# ============================================

# IMAGE — one adapter (OpenAI). Metered; every generation costs money.
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# VIDEO — one adapter (Replicate). Metered, asynchronous, and the most
# expensive capability per request. The model is configurable so a different
# Replicate-hosted model is a variable, not a source edit.
# REPLICATE_API_KEY=
# REPLICATE_VIDEO_MODEL=minimax/video-01

# TEXT-TO-SPEECH — one adapter (OpenAI).
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy

# SPEECH-TO-TEXT — OpenAI-compatible /v1/audio/transcriptions (Whisper).
# Point STT_BASE_URL at faster-whisper-server or a hosted Whisper endpoint.
# STT_API_KEY is only needed if that endpoint requires one.
# STT_BASE_URL=
# STT_MODEL=Systran/faster-whisper-small
# STT_API_KEY=

# WEB SEARCH — Wikipedia (keyless, on by default; set SEARCH_WIKIPEDIA_ENABLED=false to turn off)
# and optionally a self-hosted SearXNG instance with the JSON format enabled.
# SEARCH_WIKIPEDIA_ENABLED=true
# SEARCH_SEARXNG_BASE_URL=

# SELF-HOSTED TEXT-TO-SPEECH — OpenAI-compatible /v1/audio/speech (e.g. Kokoro-FastAPI).
# Listed before OpenAI, so a free endpoint wins over a paid key. Voice names are server-specific.
# TTS_SELF_HOSTED_BASE_URL=
# TTS_SELF_HOSTED_MODEL=kokoro
# TTS_SELF_HOSTED_VOICE=af_heart
# TTS_SELF_HOSTED_API_KEY=

# EMBEDDINGS — needed for RAG. A local/self-hosted endpoint costs nothing
# per token and is enough for the whole retrieval path.
# VOYAGE_API_KEY=
# COHERE_API_KEY=
# SELF_HOSTED_EMBEDDINGS_BASE_URL=
# SELF_HOSTED_EMBEDDINGS_MODEL=

# VECTOR STORAGE — pgvector reuses the PostgreSQL Synora already runs. No
# account, no credential, no cost. Opt-in so it cannot silently win
# auto-detection over a purpose-built vector database.
# VECTORDB_PGVECTOR_ENABLED=true
# PINECONE_API_KEY=
# QDRANT_URL=
# WEAVIATE_URL=

# ============================================
# SPEND CONTROL — set these BEFORE any paid key
#
# Staging and production REFUSE TO START if a metered provider credential is
# present and neither cap below is set. That is deliberate: an uncapped key
# in a public-facing application is an unbounded liability.
# ============================================
# AI_GLOBAL_MAX_COST_PER_DAY_CENTS=500
# AI_GLOBAL_MAX_TOKENS_PER_DAY=
# AI_USER_MAX_COST_PER_DAY_CENTS=

# ============================================
# QUANTUM — every default here refuses. Doing nothing costs nothing.
# The free in-process simulator is all that level 0 reaches.
# ============================================
# QUANTUM_MAX_EXECUTION_LEVEL=0
# QUANTUM_PAID_QPU_ENABLED=false
# QUANTUM_MAX_COST_PER_EXECUTION_CENTS=0
# QUANTUM_LOCAL_MAX_QUBITS=20
# QUANTUM_MAX_SHOTS=100000
# QUANTUM_MAX_CIRCUIT_DEPTH=10000
# QUANTUM_MAX_QUBITS=64
# QUANTUM_MAX_RUNTIME_MS=300000
# IBM_QUANTUM_API_TOKEN=
# IBM_QUANTUM_INSTANCE=
# IBM_QUANTUM_OPEN_ACCESS=false


# Third-party Services (Optional)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ============================================
# Observability (all optional — each integration is a no-op until configured)
# ============================================
# Sentry error monitoring: set the DSN to enable error capture on 500s.
# SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=0

# OpenTelemetry tracing: point at any OTLP/HTTP collector (Tempo, Jaeger,
# Honeycomb, vendor agent) to enable one span per API request.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=synora-backend

# Prometheus scrape endpoint GET /metrics is always on. Set a token to
# require `Authorization: Bearer <token>` from the scraper on public hosts.
# METRICS_TOKEN=
