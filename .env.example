# Environment
NODE_ENV=development
# APP_ENV: local | development | staging | production — selects the
# secrets source chain. See docs/security/SECRET_MANAGEMENT.md.
APP_ENV=local

# Database
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora

# Authentication
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# API
BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# AI Providers (to be configured)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REPLICATE_API_KEY=

# Third-party Services (Optional)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
