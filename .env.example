# ========================================
# SYNORA PLATFORM
# ========================================

APP_NAME=Synora
APP_ENV=development
APP_VERSION=0.1.0
NODE_ENV=development
LOG_LEVEL=info
DEFAULT_REGION=asia-south1
TIMEZONE=UTC

# ----------------------------------------
# Feature flags
# ----------------------------------------
ENABLE_TELEMETRY=true
ENABLE_ANALYTICS=false
ENABLE_EXPERIMENTS=true
ENABLE_CACHE=true
ENABLE_VECTOR_MEMORY=true
ENABLE_EVENT_BUS=true
ENABLE_MULTI_AGENT=true
ENABLE_OBSERVABILITY=true
ENABLE_WORKFLOWS=true
ENABLE_PLUGIN_SYSTEM=true
ENABLE_DOCUMENT_PROCESSING=true
ENABLE_WEB_SEARCH=true
ENABLE_CODE_EXECUTION=true
ENABLE_IMAGE_GENERATION=true
ENABLE_VIDEO_GENERATION=false
ENABLE_AUDIO_GENERATION=true

# ----------------------------------------
# Providers & services
# ----------------------------------------
DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_EMBEDDING_PROVIDER=openai-compatible
DEFAULT_VECTOR_DATABASE=qdrant
DEFAULT_DATABASE=postgres
DEFAULT_CACHE=redis
DEFAULT_OBJECT_STORAGE=s3-compatible
DEFAULT_EVENT_BUS=nats
DEFAULT_QUEUE=redis
DEFAULT_SEARCH_PROVIDER=tavily
DEFAULT_AUTH_PROVIDER=better-auth
DEFAULT_PAYMENT_PROVIDER=razorpay
DEFAULT_STORAGE_PROVIDER=s3

# ----------------------------------------
# Tooling & infrastructure
# ----------------------------------------
DEFAULT_DEPLOYMENT=docker
DEFAULT_RUNTIME=node
DEFAULT_PACKAGE_MANAGER=pnpm
DEFAULT_TEST_FRAMEWORK=vitest
DEFAULT_E2E_FRAMEWORK=playwright
DEFAULT_LINTER=eslint
DEFAULT_FORMATTER=prettier
DEFAULT_CI=github-actions
DEFAULT_CONTAINER_ENGINE=docker
DEFAULT_INFRASTRUCTURE=terraform
DEFAULT_MONITORING=opentelemetry
DEFAULT_METRICS=prometheus
DEFAULT_DASHBOARD=grafana
DEFAULT_TRACING=jaeger
DEFAULT_SECRET_MANAGER=environment
DEFAULT_WORKFLOW_ENGINE=temporal
DEFAULT_MESSAGE_BUS=nats
