# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
GATEWAY_PORT=8080

# --- Event bus (in-memory | redis) ---
EVENT_BUS_DRIVER=in-memory
REDIS_URL=redis://localhost:6379

# --- Memory / vector store (in-memory | pgvector) ---
VECTOR_STORE_DRIVER=in-memory
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora

# --- Model providers (set the ones you use; the platform stays agnostic) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_MODEL_PROVIDER=anthropic
DEFAULT_MODEL=claude-sonnet-5

# --- Embeddings ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# --- Security ---
# Comma-separated list of "keyId:secret:scope1|scope2" pairs for local dev.
API_KEYS=dev-key:dev-secret:admin
JWT_SIGNING_SECRET=change-me-in-production
RATE_LIMIT_PER_MINUTE=120

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
SERVICE_NAME=synora-gateway
