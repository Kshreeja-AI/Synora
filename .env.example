# Environment
NODE_ENV=development
# APP_STAGE: development | testing | qa | staging | production
# See docs/operations/ENVIRONMENT_MANAGEMENT.md for the full stage/mode model.
APP_STAGE=development

# Operating Modes (independent of APP_STAGE — any combination may apply)
# OFFLINE_MODE=false
# MOCK_MODE=false
# ENTERPRISE_MODE=false
# GOVERNMENT_MODE=false
# SELF_HOSTED_MODE=false

# Database
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora

# Authentication
NEXTAUTH_SECRET=your-secret-key-here-change-in-production
NEXTAUTH_URL=http://localhost:3000

# API
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# AI Providers (to be configured)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REPLICATE_API_KEY=

# Third-party Services (Optional)
# GITHUB_ID=
# GITHUB_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
