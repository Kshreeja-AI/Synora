# Server
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora

# Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Provider Abstraction Layer
# When true, every AI/video/audio provider is served by an in-memory mock —
# no network calls, no API keys required. This is how local development and
# CI run by default; see apps/backend/src/providers/ for the abstraction.
USE_MOCK_PROVIDERS=true

# AI Providers (only needed when USE_MOCK_PROVIDERS=false)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REPLICATE_API_KEY=
# RUNWAYML_API_KEY=
# SYNTHESIA_API_KEY=
