# Server
NODE_ENV=development
# APP_STAGE: development | testing | qa | staging | production
# Authoritative deployment stage — see docs/operations/ENVIRONMENT_MANAGEMENT.md.
# Falls back to NODE_ENV, then "development", if unset.
APP_STAGE=development
PORT=3001
LOG_LEVEL=debug
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Operating Modes (independent of APP_STAGE — any combination may apply)
# OFFLINE_MODE=false
# MOCK_MODE=false
# ENTERPRISE_MODE=false
# GOVERNMENT_MODE=false
# SELF_HOSTED_MODE=false
# Alternative bulk form, ORed with the discrete flags above:
# APP_MODES=mock,offline

# Secrets
# APP_STAGE (and MOCK_MODE) select the secrets source chain — see
# apps/backend/src/secrets/factory.ts and docs/security/SECRET_MANAGEMENT.md:
#   development | testing | qa -> env vars, falling back to generated placeholders
#   staging | production       -> Kubernetes/Docker mounted secrets, then env vars
#                                   (placeholders only if MOCK_MODE=true)
# Leave every secret below unset to run entirely on placeholders.

# Database
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora

# Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Providers (to be configured)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REPLICATE_API_KEY=

# Queue (BullMQ + Redis) — see docs/queue/ARCHITECTURE.md
# QUEUE_ENABLED=true
REDIS_URL=redis://localhost:6379
# Alternative to REDIS_URL: discrete host/port/password/db/tls
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
# QUEUE_WORKERS_GENERATE_RESPONSE=5
# QUEUE_WORKERS_INDEX_MESSAGE_SEARCH=2
# QUEUE_WORKERS_GENERATE_EMBEDDINGS=2
# QUEUE_WORKERS_PROCESS_FILE=3
# QUEUE_WORKERS_CLEANUP=1
# QUEUE_WORKERS_NOTIFICATION=2
# QUEUE_RETRY_ATTEMPTS=3
# QUEUE_RETRY_BACKOFF_MS=1000
# QUEUE_RETRY_BACKOFF_STRATEGY=exponential
# QUEUE_DEAD_LETTER_ENABLED=true
# QUEUE_DEAD_LETTER_RETENTION_MS=86400000
# QUEUE_RATE_LIMIT_ENABLED=true
# QUEUE_RATE_LIMIT_MAX_JOBS_PER_SECOND=100

# Embeddings — see apps/backend/docs/embeddings/ARCHITECTURE.md
# EMBEDDING_ENABLED=true
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=                    # also used by the OpenAI embeddings provider
# GOOGLE_AI_API_KEY=                 # also used by the Gemini embeddings provider
# VOYAGE_API_KEY=
# COHERE_API_KEY=
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# EMBEDDING_GEMINI_MODEL=text-embedding-004
# EMBEDDING_VOYAGE_MODEL=voyage-3
# EMBEDDING_COHERE_MODEL=embed-english-v3.0
# EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434/v1
# EMBEDDING_OLLAMA_MODEL=nomic-embed-text
# EMBEDDING_OLLAMA_MAX_BATCH_SIZE=64
# EMBEDDING_SELF_HOSTED_BASE_URL=
# EMBEDDING_SELF_HOSTED_API_KEY=
# EMBEDDING_SELF_HOSTED_MODEL=nomic-embed-text
# EMBEDDING_SELF_HOSTED_MAX_BATCH_SIZE=64
# EMBEDDING_CACHE_BACKEND=memory      # memory | redis
# EMBEDDING_CACHE_MAX_ENTRIES=10000
# EMBEDDING_CACHE_TTL_MS=86400000
# EMBEDDING_CACHE_REDIS_URL=redis://localhost:6379
# EMBEDDING_RATE_LIMIT_BACKEND=memory # memory | redis
# EMBEDDING_RATE_LIMIT_REQUESTS_PER_SECOND=50
# EMBEDDING_RATE_LIMIT_REDIS_URL=redis://localhost:6379
# EMBEDDING_RETRY_ATTEMPTS=3
# EMBEDDING_RETRY_BACKOFF_MS=500
# EMBEDDING_RETRY_BACKOFF_STRATEGY=exponential
# EMBEDDING_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# EMBEDDING_CIRCUIT_BREAKER_COOLDOWN_MS=30000
# EMBEDDING_CIRCUIT_BREAKER_HALF_OPEN_SUCCESS_THRESHOLD=2
# EMBEDDING_SECURITY_MAX_INPUT_CHARS=50000
# EMBEDDING_SECURITY_MAX_BATCH_REQUEST_SIZE=1000
# EMBEDDING_CHUNKING_DEFAULT_CHUNK_SIZE=1000
# EMBEDDING_CHUNKING_DEFAULT_OVERLAP=100
