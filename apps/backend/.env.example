# Server
NODE_ENV=development
# APP_STAGE: development | testing | qa | staging | production
# Authoritative deployment stage — see docs/operations/ENVIRONMENT_MANAGEMENT.md.
# Falls back to NODE_ENV, then "development", if unset.
APP_STAGE=development
PORT=3001
LOG_LEVEL=debug
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Operating Modes (independent of APP_STAGE — any combination may apply)
# OFFLINE_MODE=false
# MOCK_MODE=false
# ENTERPRISE_MODE=false
# GOVERNMENT_MODE=false
# SELF_HOSTED_MODE=false
# Alternative bulk form, ORed with the discrete flags above:
# APP_MODES=mock,offline

# Secrets
# APP_STAGE (and MOCK_MODE) select the secrets source chain — see
# apps/backend/src/secrets/factory.ts and docs/security/SECRET_MANAGEMENT.md:
#   development | testing | qa -> env vars, falling back to generated placeholders
#   staging | production       -> Kubernetes/Docker mounted secrets, then env vars
#                                   (placeholders only if MOCK_MODE=true)
# Leave every secret below unset to run entirely on placeholders.

# Database
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora
# Connection pool is bounded (connection_limit=10, pool_timeout=20s) unless
# overridden here or via query params on DATABASE_URL itself. See
# packages/database/src/index.ts.
# DB_CONNECTION_LIMIT=10
# DB_POOL_TIMEOUT=20

# Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Tool secret encryption — REQUIRED in staging/production (min 32 chars).
# Master key for AES-256-GCM encryption of user-stored tool secrets.
# Generate with: openssl rand -base64 32
# TOOL_SECRET_MASTER_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Providers (to be configured). Text generation activates when any
# provider key is set; image generation activates when OPENAI_API_KEY is set
# (OpenAI is the only image provider today). Verify with
# GET /api/capabilities after adding a key.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-1
# Text-to-speech (POST /api/audio/generate) also activates on OPENAI_API_KEY.
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_VOICE=alloy
# ANTHROPIC_API_KEY=
# REPLICATE_API_KEY=
# Outbound pacing toward text-generation vendors, per provider — Synora's
# own limit, refused before the request is sent (HTTP 429), so a runaway
# caller never burns quota or money. Set requests-per-second from your
# vendor tier on credential day. Use the redis backend when running more
# than one backend instance.
# AI_RATE_LIMIT_BACKEND=memory        # memory | redis
# AI_RATE_LIMIT_REQUESTS_PER_SECOND=10
# AI_RATE_LIMIT_REDIS_URL=redis://localhost:6379

# Queue (BullMQ + Redis) — see docs/queue/ARCHITECTURE.md
# QUEUE_ENABLED=true
REDIS_URL=redis://localhost:6379
# Alternative to REDIS_URL: discrete host/port/password/db/tls
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_TLS=false
# QUEUE_WORKERS_GENERATE_RESPONSE=5
# QUEUE_WORKERS_INDEX_MESSAGE_SEARCH=2
# QUEUE_WORKERS_GENERATE_EMBEDDINGS=2
# QUEUE_WORKERS_PROCESS_FILE=3
# QUEUE_WORKERS_CLEANUP=1
# QUEUE_WORKERS_NOTIFICATION=2
# QUEUE_RETRY_ATTEMPTS=3
# QUEUE_RETRY_BACKOFF_MS=1000
# QUEUE_RETRY_BACKOFF_STRATEGY=exponential
# QUEUE_DEAD_LETTER_ENABLED=true
# QUEUE_DEAD_LETTER_RETENTION_MS=86400000
# QUEUE_RATE_LIMIT_ENABLED=true
# QUEUE_RATE_LIMIT_MAX_JOBS_PER_SECOND=100

# Embeddings — see apps/backend/docs/embeddings/ARCHITECTURE.md
# EMBEDDING_ENABLED=true
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=                    # also used by the OpenAI embeddings provider
# GOOGLE_AI_API_KEY=                 # also used by the Gemini embeddings provider
# VOYAGE_API_KEY=
# COHERE_API_KEY=
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small
# EMBEDDING_GEMINI_MODEL=text-embedding-004
# EMBEDDING_VOYAGE_MODEL=voyage-3
# EMBEDDING_COHERE_MODEL=embed-english-v3.0
# EMBEDDING_OLLAMA_BASE_URL=http://localhost:11434/v1
# EMBEDDING_OLLAMA_MODEL=nomic-embed-text
# EMBEDDING_OLLAMA_MAX_BATCH_SIZE=64
# EMBEDDING_SELF_HOSTED_BASE_URL=
# EMBEDDING_SELF_HOSTED_API_KEY=
# EMBEDDING_SELF_HOSTED_MODEL=nomic-embed-text
# EMBEDDING_SELF_HOSTED_MAX_BATCH_SIZE=64
# EMBEDDING_CACHE_BACKEND=memory      # memory | redis
# EMBEDDING_CACHE_MAX_ENTRIES=10000
# EMBEDDING_CACHE_TTL_MS=86400000
# EMBEDDING_CACHE_REDIS_URL=redis://localhost:6379
# EMBEDDING_RATE_LIMIT_BACKEND=memory # memory | redis
# EMBEDDING_RATE_LIMIT_REQUESTS_PER_SECOND=50
# EMBEDDING_RATE_LIMIT_REDIS_URL=redis://localhost:6379
# EMBEDDING_RETRY_ATTEMPTS=3
# EMBEDDING_RETRY_BACKOFF_MS=500
# EMBEDDING_RETRY_BACKOFF_STRATEGY=exponential
# EMBEDDING_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# EMBEDDING_CIRCUIT_BREAKER_COOLDOWN_MS=30000
# EMBEDDING_CIRCUIT_BREAKER_HALF_OPEN_SUCCESS_THRESHOLD=2
# EMBEDDING_SECURITY_MAX_INPUT_CHARS=50000
# EMBEDDING_SECURITY_MAX_BATCH_REQUEST_SIZE=1000
# EMBEDDING_CHUNKING_DEFAULT_CHUNK_SIZE=1000
# EMBEDDING_CHUNKING_DEFAULT_OVERLAP=100

# Vector Database — see apps/backend/docs/vectordb/ARCHITECTURE.md
# VECTORDB_ENABLED=true
# VECTORDB_PROVIDER=pinecone
# PINECONE_API_KEY=
# VECTORDB_PINECONE_HOST=my-index-abc123.svc.us-east1-aws.pinecone.io
# VECTORDB_PINECONE_MAX_UPSERT_BATCH_SIZE=100
# VECTORDB_QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
# VECTORDB_QDRANT_MAX_UPSERT_BATCH_SIZE=500
# VECTORDB_WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=
# VECTORDB_WEAVIATE_MAX_UPSERT_BATCH_SIZE=200
# VECTORDB_MILVUS_URL=http://localhost:19530
# MILVUS_TOKEN=
# VECTORDB_MILVUS_MAX_UPSERT_BATCH_SIZE=500
# VECTORDB_PGVECTOR_ENABLED=false     # reuses DATABASE_URL — no separate connection needed
# VECTORDB_PGVECTOR_DIMENSIONS=1536
# VECTORDB_PGVECTOR_MAX_UPSERT_BATCH_SIZE=500
# VECTORDB_SECURITY_MAX_UPSERT_REQUEST_SIZE=1000
# VECTORDB_SECURITY_MAX_TOP_K=1000
# VECTORDB_SECURITY_MAX_DIMENSIONS=4096

# --- Agents -----------------------------------------------------------------
# Directory for durable agent definitions and runs. When UNSET, agents and
# runs live only in memory and are lost on restart — which is fine for a
# throwaway instance but is NOT persistence, and the server logs which mode
# it chose so this is never left to guesswork.
# AGENT_STORE_DIR=./.synora/agents
# Workflow schedules are stored alongside agents in AGENT_STORE_DIR. With
# that unset, schedules do not survive a restart — and a schedule that
# vanishes silently stops running, which is worse than one that never
# existed. The server logs which mode it chose.

# --- AI spend caps (ai/spend-guard.ts) -------------------------------------
# Process-wide hard ceilings, enforced BEFORE any generation runs. Absent
# means no global cap (the development default). These are the deployment's
# kill switch; per-workspace caps live in the AiSpendBudget table. Token
# caps exist separately because locally-served models (Ollama/self-hosted)
# have no per-token price, so a cost cap alone would never bind them.
# AI_GLOBAL_MAX_COST_PER_DAY_CENTS=500
# AI_GLOBAL_MAX_TOKENS_PER_DAY=2000000

# --- Remote/protected Ollama endpoint auth ---------------------------------
# Optional Bearer token for a PROTECTED Ollama endpoint. Bare local Ollama
# checks no key; a REMOTE deployment must sit behind a token-checking TLS
# proxy (never expose raw Ollama to the internet), and these are the tokens
# those proxies check.
# OLLAMA_API_KEY=
# EMBEDDING_OLLAMA_API_KEY=

# --- Multi-model + generic OpenAI-compatible endpoints ---------------------
# Named models the Ollama endpoint serves (comma-separated). Selection stays
# per-request; this list declares what exists for the catalog and for
# side-by-side benchmarking. The default OLLAMA_MODEL need not be repeated.
# OLLAMA_MODELS=llama3.1,qwen2.5-coder,phi4
#
# Any OpenAI-compatible text server (vLLM, TGI, llama.cpp server, a second
# Ollama). BOTH url and model are required to count as configured. Swapping
# runtimes on the GPU box is a change to these variables, never to code.
# SELF_HOSTED_TEXT_BASE_URL=
# SELF_HOSTED_TEXT_API_KEY=
# SELF_HOSTED_TEXT_MODEL=
# SELF_HOSTED_TEXT_MODELS=
#
# Groq (hosted open-source inference, free tier; key read from SecretsManager)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
