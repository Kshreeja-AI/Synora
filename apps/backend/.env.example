# Server
NODE_ENV=development
APP_ENV=local
PORT=3001
LOG_LEVEL=debug

# Secrets
# APP_ENV selects the secrets source chain (see apps/backend/src/secrets/factory.ts):
#   local | development -> env vars, falling back to generated placeholders
#   staging | production -> Kubernetes/Docker mounted secrets, then env vars — never placeholders
# Leave every secret below unset to run entirely on placeholders.

# Database
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora

# Authentication
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGINS=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AI Providers (to be configured)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# REPLICATE_API_KEY=
