# =============================================================================
#  SYNORA — ENVIRONMENT TEMPLATE
# =============================================================================
#
#  Copy to .env.local, then fill in only the lines marked [FOUNDER].
#
#    powershell -ExecutionPolicy Bypass -File scripts\init-env.ps1
#    powershell -ExecutionPolicy Bypass -File scripts\check-env.ps1
#
#  WHAT IS NOT IN THIS FILE, AND WHY.
#  Synora reads about 161 environment variables. Roughly 134 are tuning knobs
#  — batch sizes, retry counts, timeouts, queue concurrency — and every one of
#  them already has a working default in `src/config/defaults.ts`. Listing them
#  here would turn a ten-minute setup into an afternoon of reading, and each
#  copied line is one more thing that can silently drift from the code.
#
#  So this file is deliberately short. If a variable is absent here, the code
#  has a sane default and you do not need to think about it. Override one only
#  when you have a specific reason; see `docs/operations/ENVIRONMENT_MANAGEMENT.md`.
#
#  LABELS
#    [FOUNDER]   You must supply this. Nobody and nothing else can.
#    [OPTIONAL]  Leave blank. A feature stays off; nothing breaks.
#    [AUTO]      Generated by init-env.ps1. Never type one by hand.
#    [FIXED]     Leave as-is unless you know exactly why you are changing it.
#
#  SECRET vs PUBLIC is marked per line. PUBLIC values are readable by any
#  visitor to the site — never put a secret behind a NEXT_PUBLIC_ name.
#
#  Never commit a filled-in copy. .env.local is git-ignored on purpose.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. APPLICATION
# -----------------------------------------------------------------------------

# [FIXED] public — development | production. Chooses safe dev behaviour vs strict production behaviour.
NODE_ENV=development

# [FIXED] public — development | staging | production. Production refuses to start
# on a localhost address or a placeholder secret. That refusal is a feature.
APP_STAGE=development

# [FIXED] public — port the API listens on.
PORT=3001

# [OPTIONAL] public — error | warn | info | debug.
LOG_LEVEL=info

# [FOUNDER] public — public address of the WEBSITE. Used to build links in emails.
# Local: http://localhost:3000   Production: your real domain.
FRONTEND_URL=http://localhost:3000

# [FOUNDER] public — public address of the API. Used to build links to uploaded files.
# Local: http://localhost:3001   Production: your real API address.
BACKEND_URL=http://localhost:3001

# [FOUNDER] public — which website addresses may call the API. Comma-separated.
# ONE authoritative setting: normal requests and live updates both read it.
# Getting this wrong in production breaks live updates while everything else looks fine.
CORS_ORIGINS=http://localhost:3000


# -----------------------------------------------------------------------------
# 2. LOCAL DATABASE
# -----------------------------------------------------------------------------

# [FOUNDER] SECRET — where PostgreSQL lives, including its password.
# Local default matches docker-compose.dev.yml.
DATABASE_URL=postgresql://synora:synora@localhost:5432/synora


# -----------------------------------------------------------------------------
# 3. REDIS
# -----------------------------------------------------------------------------

# [FOUNDER] SECRET when it carries a password — background job queue.
REDIS_URL=redis://localhost:6379

# [OPTIONAL] public — true when your Redis requires TLS. Managed Redis usually does.
REDIS_TLS=false


# -----------------------------------------------------------------------------
# 4. AUTHENTICATION SECRETS
#
#    Do not invent these. init-env.ps1 generates all three from a
#    cryptographic random source and writes them straight to .env.local.
#    They are pure random bytes with no counterparty — nothing outside Synora
#    needs to agree with them, which is exactly what makes them generatable.
# -----------------------------------------------------------------------------

# [AUTO] SECRET — signs the tokens that keep someone logged in.
# Changing it logs every user out immediately.
JWT_SECRET=

# [AUTO] SECRET — encrypts the credentials users store for their own tools.
# After launch, changing it makes every stored tool credential permanently unreadable.
TOOL_SECRET_MASTER_KEY=

# [AUTO] SECRET — reserved for the future sign-in flow.
NEXTAUTH_SECRET=


# -----------------------------------------------------------------------------
# 5. AI PROVIDER
#
#    Synora is provider-agnostic. Business logic never learns a vendor's name;
#    a provider is chosen here and reached through an adapter. Swapping
#    providers is editing this section, never rewriting the product.
# -----------------------------------------------------------------------------

# [FIXED] public — which provider serves text. `self-hosted` selects the
# OpenAI-compatible router configured in section 10. Leave blank to auto-detect
# the first configured provider — pin it explicitly in production so a stray
# key elsewhere cannot quietly take over.
AI_PROVIDER=self-hosted

# [OPTIONAL] SECRET — direct vendor keys. Every one is optional: leave blank
# unless you are actually using that provider. A blank optional key is not a
# problem and never blocks launch.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=
AZURE_OPENAI_API_KEY=
REPLICATE_API_KEY=


# -----------------------------------------------------------------------------
# 6. AI SPENDING SAFETY
#
#    These are the brakes. Checked BEFORE a request reaches a provider, so an
#    over-budget request never costs anything.
#
#    If a cost cap is set and Synora cannot price the model, it refuses or
#    charges a worst-case ceiling — it never treats an unknown price as free,
#    because "free" means the cap never trips and the bill has no limit.
# -----------------------------------------------------------------------------

# [FOUNDER] public — platform-wide daily ceiling, in cents. 500 = $5.00/day.
AI_GLOBAL_MAX_COST_PER_DAY_CENTS=500

# [FOUNDER] public — per-user daily ceiling, in cents.
AI_USER_MAX_COST_PER_DAY_CENTS=100

# [OPTIONAL] public — daily token ceiling. This is what bounds a self-hosted
# model, which has no per-token price for a cost cap to act on.
AI_GLOBAL_MAX_TOKENS_PER_DAY=2000000


# -----------------------------------------------------------------------------
# 7. EMBEDDINGS  (off by default)
#
#    Turns text into numbers so Synora can find things by meaning rather than
#    by exact wording. Needed for semantic search and memory.
# -----------------------------------------------------------------------------

# [OPTIONAL] public — leave false until you need semantic search.
EMBEDDING_ENABLED=false

# [OPTIONAL] public — openai | ollama | self-hosted | cohere | voyage | gemini
EMBEDDING_PROVIDER=

# [OPTIONAL] SECRET — only for the provider selected above.
VOYAGE_API_KEY=
COHERE_API_KEY=


# -----------------------------------------------------------------------------
# 8. VECTOR DATABASE  (off by default)
#
#    Stores those numbers so similarity search is fast. Only needed once
#    embeddings are enabled.
# -----------------------------------------------------------------------------

# [OPTIONAL] public
VECTORDB_ENABLED=false

# [OPTIONAL] public — pgvector | qdrant | pinecone | weaviate | milvus
# pgvector reuses the PostgreSQL you already run: no extra service.
VECTORDB_PROVIDER=

# [OPTIONAL] SECRET — only for the provider selected above.
PINECONE_API_KEY=
QDRANT_API_KEY=
WEAVIATE_API_KEY=
MILVUS_TOKEN=


# -----------------------------------------------------------------------------
# 9. AGENTS AND BACKGROUND WORK
# -----------------------------------------------------------------------------

# [OPTIONAL] public — background workers (generation, indexing, file processing).
# Requires REDIS_URL above.
QUEUE_ENABLED=true

# [OPTIONAL] public — where agent run state is written on disk.
AGENT_STORE_DIR=


# -----------------------------------------------------------------------------
# 10. SELF-HOSTED / FUTURE SYNORA MODEL
#
#     The generic slot for ANY OpenAI-compatible endpoint: a hosted router
#     today, your own model later. Deliberately not named after a vendor —
#     a future Synora model enters through this same slot as a peer, and no
#     code outside the provider layer will know the difference.
# -----------------------------------------------------------------------------

# [FOUNDER] public — base URL, ending in /v1. Not a secret.
SELF_HOSTED_TEXT_BASE_URL=

# [FOUNDER] SECRET — the key for that endpoint.
SELF_HOSTED_TEXT_API_KEY=

# [FOUNDER] public — the model identifier, spelled exactly as the endpoint
# spells it. Ask the endpoint (GET /v1/models); do not assume. There is no
# cross-vendor convention, and a display name is not always the technical id.
SELF_HOSTED_TEXT_MODEL=

# [OPTIONAL] public — comma-separated allow-list of selectable models.
SELF_HOSTED_TEXT_MODELS=


# -----------------------------------------------------------------------------
# 11. PRODUCTION / HOSTINGER
#
#     Not read by Synora at runtime. Deployment tooling only.
#     The VPS IP is where the server lives; it is NOT an application address.
#     Application addresses are the domain names in section 1.
# -----------------------------------------------------------------------------

# [FOUNDER] SECRET — Hostinger API token. Only Hostinger can issue or revoke it.
HOSTINGER_API_TOKEN=

# [AUTO] public — discovered from the Hostinger API. Not secret.
VPS_ID=
VPS_IP=

# [FOUNDER] public — your apex domain, used by the production compose file
# and the reverse proxy.
SYNORA_DOMAIN=

# [AUTO] SECRET — password for the production PostgreSQL container.
# Generated; only the containers ever read it.
POSTGRES_PASSWORD=

# [OPTIONAL] SECRET — error reporting. Blank disables it.
SENTRY_DSN=

# [OPTIONAL] SECRET — guards the metrics endpoint. Blank leaves it closed.
METRICS_TOKEN=
