{
  "name": "@synora/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Synora AI Platform - Backend API",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "db:generate": "prisma generate --schema ../../packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema ../../packages/database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema ../../packages/database/prisma/schema.prisma",
    "capabilities:report": "tsx src/cli/capabilityReport.ts",
    "providers:health": "tsx src/cli/providerHealth.ts",
    "smoke:text": "tsx src/cli/textSmokeTest.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.5",
    "@aws-sdk/client-bedrock-runtime": "^3.1092.0",
    "@elastic/elasticsearch": "^9.4.3",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/client": "^5.7.1",
    "@sentry/node": "^10.69.0",
    "@synora/database": "workspace:*",
    "@synora/shared": "workspace:*",
    "@types/socket.io": "^3.0.2",
    "argon2": "^0.45.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.1.4",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "stripe": "^14.21.0",
    "winston": "^3.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@supabase/cli": "^1.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "compression": "^1.8.2",
    "prisma": "^5.7.1",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.7.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
