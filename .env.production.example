# Synora production environment. Copy to .env.production and fill in.
# NEVER commit .env.production. Placeholders only in this file.

# ---- REQUIRED ----
SYNORA_DOMAIN=example.com
POSTGRES_PASSWORD=<generate: openssl rand -base64 24>
JWT_SECRET=<generate: openssl rand -base64 48>
NEXTAUTH_SECRET=<generate: openssl rand -base64 48>
TOOL_SECRET_MASTER_KEY=<generate: openssl rand -base64 32>
# The AI kill switch. Staging/production REFUSE TO BOOT with a real metered
# AI key and no cap (config/productionGates.ts). Set BEFORE any paid key.
AI_GLOBAL_MAX_COST_PER_DAY_CENTS=500
AI_GLOBAL_MAX_TOKENS_PER_DAY=2000000

APP_STAGE=production
LOG_LEVEL=info
CORS_ORIGINS=https://example.com
BACKEND_URL=https://example.com
FRONTEND_URL=https://example.com

# ---- OPTIONAL: AI PROVIDERS (all optional; none architectural) ----
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
# OLLAMA_BASE_URL=
# OLLAMA_API_KEY=
# OLLAMA_MODEL=
# GROQ_API_KEY=

# ---- OPTIONAL: EMAIL (console transport until set) ----
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# ---- OPTIONAL: BILLING (degrades honestly without) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
